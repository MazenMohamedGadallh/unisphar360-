# Copy to .env.local and adjust if needed.

# Development only: where Vite forwards /api and /uploads (default http://localhost:5080).
VITE_API_PROXY=http://localhost:5080

# Production builds hosted on a different origin from the API: the API's base URL.
# Leave empty when the frontend and API share an origin (or when using the dev proxy).
VITE_API_BASE_URL=
