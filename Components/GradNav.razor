@* Graduate sidebar navigation — exact labels required by spec.
   Used by MainLayout whenever the signed-in role is Graduate. *@
@namespace UniSphere.Api.Components
<nav class="min-h-0 flex-1 overflow-y-auto px-3 py-4">
    <NavLink href="/graduate" Match="NavLinkMatch.All" class="@Item" ActiveClass="@ItemActive" @onclick="HandleNavigate">
        <span class="@Icon"><UiIcon Name="house" /></span>
        <span>Career Overview</span>
    </NavLink>
    <NavLink href="/graduate/profile" class="@Item" ActiveClass="@ItemActive" @onclick="HandleNavigate">
        <span class="@Icon"><UiIcon Name="user-round" /></span>
        <span>My Career Profile</span>
    </NavLink>
    <NavLink href="/graduate/cv" class="@Item" ActiveClass="@ItemActive" @onclick="HandleNavigate">
        <span class="@Icon"><UiIcon Name="file-text" /></span>
        <span>CV &amp; Resume Studio</span>
    </NavLink>
    <NavLink href="/graduate/jobs" class="@Item" ActiveClass="@ItemActive" @onclick="HandleNavigate">
        <span class="@Icon"><UiIcon Name="search" /></span>
        <span>Find Jobs</span>
    </NavLink>
    <NavLink href="/graduate/matches" class="@Item" ActiveClass="@ItemActive" @onclick="HandleNavigate">
        <span class="@Icon"><UiIcon Name="thumbs-up" /></span>
        <span>AI Job Matches</span>
    </NavLink>
    <NavLink href="/graduate/skill-gap" class="@Item" ActiveClass="@ItemActive" @onclick="HandleNavigate">
        <span class="@Icon"><UiIcon Name="target" /></span>
        <span>Skill Gap Analysis</span>
    </NavLink>
    <NavLink href="/graduate/roadmap" class="@Item" ActiveClass="@ItemActive" @onclick="HandleNavigate">
        <span class="@Icon"><UiIcon Name="map" /></span>
        <span>Career Roadmap</span>
    </NavLink>
    <NavLink href="/graduate/applications" class="@Item" ActiveClass="@ItemActive" @onclick="HandleNavigate">
        <span class="@Icon"><UiIcon Name="file-check-2" /></span>
        <span>My Applications</span>
    </NavLink>
    <NavLink href="/graduate/interview" class="@Item" ActiveClass="@ItemActive" @onclick="HandleNavigate">
        <span class="@Icon"><UiIcon Name="mic" /></span>
        <span>AI Interview Coach</span>
    </NavLink>
    <NavLink href="/graduate/alumni" class="@Item" ActiveClass="@ItemActive" @onclick="HandleNavigate">
        <span class="@Icon"><UiIcon Name="landmark" /></span>
        <span>Alumni &amp; University Services</span>
    </NavLink>
    <NavLink href="/graduate/events" class="@Item" ActiveClass="@ItemActive" @onclick="HandleNavigate">
        <span class="@Icon"><UiIcon Name="party-popper" /></span>
        <span>Graduated Events</span>
    </NavLink>
    <NavLink href="/graduate/insights" class="@Item" ActiveClass="@ItemActive" @onclick="HandleNavigate">
        <span class="@Icon"><UiIcon Name="chart-no-axes-combined" /></span>
        <span>Career Insights</span>
    </NavLink>
</nav>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    // Full-literal Tailwind class tokens (single tokens per string, safe for the
    // Tailwind CLI content scan; never built by concatenation).
    private const string Item =
        "group mb-1 flex w-full cursor-pointer items-center gap-3 rounded-control border-0 bg-transparent px-3 py-3 text-start text-sm font-medium text-text-secondary no-underline transition-all duration-200 hover:bg-bg hover:text-text";
    private const string ItemActive =
        "bg-primary-light! text-primary! [&_svg]:text-secondary!";
    private const string Icon =
        "flex w-6 flex-none items-center justify-center text-lg text-text-muted transition-colors group-hover:text-text-secondary";

    private Task HandleNavigate() => OnNavigate.InvokeAsync();
}
