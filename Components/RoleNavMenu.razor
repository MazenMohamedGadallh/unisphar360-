@code {
    [Parameter] public string? Role { get; set; }
    [Parameter] public EventCallback SidebarClosed { get; set; }

    private bool Is(string role) => string.Equals(Role, role, StringComparison.OrdinalIgnoreCase);

    private async Task CloseSidebar()
    {
        if (SidebarClosed.HasDelegate)
            await SidebarClosed.InvokeAsync();
    }
}
