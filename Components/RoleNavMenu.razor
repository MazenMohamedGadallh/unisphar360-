<nav class="sidebar-nav" aria-label="Main navigation">
    @if (Is("Student"))
    {
        <NavLink href="/dashboard" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="house" /></span><span>Home</span></NavLink>
        <NavLink href="/university" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="book-open" /></span><span>My Courses</span></NavLink>
        <NavLink href="/study-planner" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="calendar-days" /></span><span>Study Plan</span></NavLink>
        <NavLink href="/student/exams" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="clipboard-check" /></span><span>My Exams</span></NavLink>
        <NavLink href="/student/assistant" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="sparkles" /></span><span>AI Assistant</span></NavLink>
        <NavLink href="/analytics" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="chart-no-axes-combined" /></span><span>Performance</span></NavLink>
        <NavLink href="/student-services" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="landmark" /></span><span>Campus</span></NavLink>
        <NavLink href="/career-assistant" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="briefcase" /></span><span>Career</span></NavLink>
        <NavLink href="/research-hub" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="microscope" /></span><span>Research Hub</span></NavLink>
    }
    else if (Is("Doctor"))
    {
        <NavLink href="/doctor" Match="NavLinkMatch.All" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="house" /></span><span>Home</span></NavLink>
        <NavLink href="/doctor/courses" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="book-open" /></span><span>My Courses</span></NavLink>
        <NavLink href="/doctor/exam-assistant" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="clipboard-list" /></span><span>Exams</span></NavLink>
        <NavLink href="/doctor/ai" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="sparkles" /></span><span>AI Assistant</span></NavLink>
        <NavLink href="/doctor/research" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="microscope" /></span><span>Research Hub</span></NavLink>
    }
    else if (Is("Graduate"))
    {
        <GradNav OnNavigate="CloseSidebar" />
    }
    else if (Is("Admin"))
    {
        <NavLink href="/admin" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="shield-check" /></span><span>Admin Panel</span></NavLink>
        <NavLink href="/chat" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="sparkles" /></span><span>AI Assistant</span></NavLink>
        <NavLink href="/search" class="nav-item" @onclick="CloseSidebar"><span class="nav-icon"><UiIcon Name="search" /></span><span>Global Search</span></NavLink>
    }
    else
    {
        <div class="sidebar-section-title">Loading navigation&hellip;</div>
    }
</nav>

@code {
    [Parameter] public string? Role { get; set; }
    [Parameter] public EventCallback SidebarClosed { get; set; }

    private bool Is(string role) => string.Equals(Role, role, StringComparison.OrdinalIgnoreCase);

    private async Task CloseSidebar()
    {
        if (SidebarClosed.HasDelegate)
            await SidebarClosed.InvokeAsync();
    }
}
