@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject UniSphere.Api.Services.BlazorAuthService AuthService

@if (_loading)
{
    <div class="flex min-h-[80vh] flex-col items-center justify-center gap-3.5 text-sm text-text-secondary" role="status">
        <span class="h-[22px] w-[22px] flex-none animate-search-spin rounded-full border-2 border-border border-t-primary" aria-hidden="true"></span>
        <span>Loading&hellip;</span>
    </div>
}

@code {
    private bool _loading = true;
    private bool _redirected;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _loading = BlazorAuthService.IsLoadingState(state.User);
        if (!_loading)
            Redirect(state);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _loading)
        {
            await AuthService.RestoreSessionAsync();
            var state = await AuthState.GetAuthenticationStateAsync();
            _loading = BlazorAuthService.IsLoadingState(state.User);
            StateHasChanged();
            return;
        }

        var current = await AuthState.GetAuthenticationStateAsync();
        if (BlazorAuthService.IsLoadingState(current.User) || _redirected)
            return;
        _redirected = true;
        Redirect(current);
    }

    private void Redirect(AuthenticationState state)
    {
        if (_redirected) return;
        _redirected = true;
        if (state.User.Identity?.IsAuthenticated == true)
        {
            var role = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            Nav.NavigateTo(UniSphere.Api.Services.RoleRoutes.HomeFor(role), replace: true);
        }
        else
        {
            Nav.NavigateTo("/login", replace: true);
        }
    }
}
