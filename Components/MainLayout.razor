@inherits LayoutComponentBase
@implements IAsyncDisposable
@using System.Net
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS
@inject ThemeService ThemeService
@inject ProtectedLocalStorage BrowserStorage
@inject UniSphere.Api.Services.BlazorAuthService AuthService

<AuthorizeView>
    <Authorized>
<div class="app-container @(_sidebarCollapsed ? "sidebar-collapsed" : "")">    <!-- Sidebar -->
    <aside class="sidebar @(_sidebarOpen ? "open" : "")">
        <div class="sidebar-header">
            <div class="logo">
                <span class="logo-icon brand-sphere"><img src="/images/unisphar-sphere-64.png" alt="UniSphere" /></span>
                <span class="logo-text">UniSphere <span class="logo-plus">360+</span></span>
            </div>
            <button class="sidebar-close" @onclick="() => _sidebarOpen = false" aria-label="Close sidebar"><UiIcon Name="x" /></button>
        </div>

        <nav class="sidebar-nav">
            <RoleNavMenu Role="@_userRole" SidebarClosed="() => _sidebarOpen = false" />
        </nav>

        <div class="sidebar-section sidebar-pinned @(_quickLinksCollapsed ? "quick-collapsed" : "")">
            <button type="button" class="sidebar-section-toggle" @onclick="ToggleQuickLinksAsync"
                    aria-expanded="@(!_quickLinksCollapsed)" aria-controls="quick-links-body"
                    title="@(_quickLinksCollapsed ? "Show quick links" : "Hide quick links")">
                <span class="sidebar-section-title">Quick Links</span>
                <span class="quick-chevron"><UiIcon Name="chevron-down" /></span>
            </button>
            <div id="quick-links-body" class="quick-links-body" hidden="@_quickLinksCollapsed">
            <NavLink href="@ProfileRoute" class="nav-item" @onclick="() => _sidebarOpen = false">
                <span class="nav-icon"><UiIcon Name="user-round" /></span>
                <span>My Profile</span>
            </NavLink>
            <NavLink href="/notifications" class="nav-item" @onclick="() => _sidebarOpen = false">
                <span class="nav-icon"><UiIcon Name="bell" /></span>
                <span>Notifications</span>
            </NavLink>
            <NavLink href="@(_userRole == "Graduate" ? "/graduate/settings" : "/settings")" class="nav-item" @onclick="() => _sidebarOpen = false">
                <span class="nav-icon"><UiIcon Name="settings" /></span>
                <span>Settings</span>
            </NavLink>
            <NavLink href="/help" class="nav-item" @onclick="() => _sidebarOpen = false">
                <span class="nav-icon"><UiIcon Name="circle-help" /></span>
                <span>Help &amp; Support</span>
            </NavLink>
            <button class="nav-item logout-btn sidebar-logout" @onclick="OpenLogoutModal" title="Log out" aria-label="Log out">
                <span class="nav-icon"><UiIcon Name="log-out" /></span>
                <span>Logout</span>
            </button>
            </div>
        </div>

        <div class="sidebar-footer">
            @if (!string.IsNullOrEmpty(_userFullName))
            {
                <div class="sidebar-user">
                    <span class="sidebar-user-avatar">@if (!string.IsNullOrEmpty(_userAvatar)) { <img src="@_userAvatar" alt="@_userFullName" /> } else { @_userInitial }</span>
                    <span class="sidebar-user-meta">
                        <span class="sidebar-user-name">@_userFullName</span>
                        @if (!string.IsNullOrEmpty(_userRole))
                        {
                            <span class="sidebar-user-role">@_userRole</span>
                        }
                    </span>
                </div>
            }
        </div>
    </aside>

    <!-- Main content -->
    <div class="main-content">
        <!-- Top bar -->
        <header class="top-bar">
            <button class="menu-toggle sidebar-toggle" @onclick="ToggleSidebarAsync" title="@(_sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")" aria-label="@(_sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")" aria-expanded="@(!_sidebarCollapsed)"><UiIcon Name="@(_sidebarCollapsed ? "panel-left-open" : "panel-left-close")" /></button>
            <button class="menu-toggle mobile-menu-toggle" @onclick="() => _sidebarOpen = !_sidebarOpen"><UiIcon Name="menu" /></button>

            <div class="search-wrap" @onkeydown="SearchKeyDown">
                <div class="search-box">
                    <span class="search-icon"><UiIcon Name="search" /></span>
                    <input id="topbar-search" type="text" placeholder="Search courses, events, modules..."
                           @bind="_searchQuery" @bind:event="oninput" @bind:after="SearchTextChangedAsync"
                           @onfocus="SearchFocused" @onblur="SearchBlurred" @ref="_searchInput"
                           autocomplete="off" role="combobox" aria-expanded="@_searchOpen" aria-label="Search" aria-controls="topbar-search-list" />
                    @if (_searchLoading)
                    {
                        <span class="search-spinner" aria-hidden="true"></span>
                    }
                </div>
                @if (_searchOpen)
                {
                    <div class="search-dropdown" id="topbar-search-list" role="listbox" aria-label="Search results">
                        @if (!string.IsNullOrEmpty(_searchError))
                        {
                            <div class="alert alert-error search-alert">@_searchError</div>
                        }
                        else if (_showRecents)
                        {
                            <div class="search-group-label">Recent searches</div>
                            @foreach (var recent in _recentSearches)
                            {
                                <div class="search-item" @onmousedown:preventDefault @onclick="() => SearchRecentAsync(recent)">
                                    <span class="search-item-icon"><UiIcon Name="history" /></span>
                                    <span class="search-item-text">@recent</span>
                                </div>
                            }
                        }
                        else if (_searchQuery.Trim().Length < 2)
                        {
                            <div class="empty-state">Type at least 2 characters to search.</div>
                        }
                        else if (!_flat.Any() && !_searchLoading)
                        {
                            <div class="empty-state">No results for "@_searchQuery".</div>
                        }
                        else
                        {
                            var lastGroup = "";
                            var flatIndex = -1;
                            @foreach (var entry in _flat)
                            {
                                flatIndex++;
                                var fi = flatIndex;
                                @if (entry.Group != lastGroup)
                                {
                                    lastGroup = entry.Group;
                                    <div class="search-group-label">@entry.Group</div>
                                }
                                <div role="option" aria-selected="@(fi == _selectedIndex)"
                                     class="search-item @(fi == _selectedIndex ? "selected" : "")"
                                     @onmousedown:preventDefault @onclick="() => SelectResultAsync(entry.Item)">
                                    <span class="search-item-icon"><UiIcon Name="@entry.Item.Icon" /></span>
                                    <span class="search-item-text">@Highlight(entry.Item.Title, _searchQuery)<small>@entry.Item.Subtitle</small></span>
                                </div>
                            }
                        }
                    </div>
                    <div class="search-backdrop" @onclick="CloseSearch"></div>
                }
            </div>

            <div class="top-bar-actions">
                <button type="button" class="icon-btn theme-toggle" title="Dark mode"
                        aria-label="@(_themeDark ? "Switch to light mode" : "Switch to dark mode")"
                        @onclick="ToggleThemeAsync">
                    <UiIcon Name="@(_themeDark ? "sun" : "moon")" />
                </button>
                <NavLink href="@AssistantRoute" class="icon-btn" title="AI Assistant">
                    <UiIcon Name="sparkles" />
                </NavLink>
                <NavLink href="/notifications" class="icon-btn" title="Notifications">
                    <UiIcon Name="bell" />
                    @if (_unreadCount > 0)
                    {
                        <span class="badge">@_unreadCount</span>
                    }
                </NavLink>
                <div class="avatar-wrap">
                    <button type="button" class="user-avatar" title="Account"
                            aria-label="Account menu" aria-expanded="@_avatarMenuOpen"
                            @onclick="ToggleAvatarMenu">
                        @if (!string.IsNullOrEmpty(_userAvatar))
                        {
                            <img src="@_userAvatar" alt="Profile" />
                        }
                        else
                        {
                            <span class="avatar-initial">@_userInitial</span>
                        }
                    </button>
                    @if (_avatarMenuOpen)
                    {
                        <div class="avatar-menu" role="menu" aria-label="Account">
                            <div class="avatar-menu-user">
                                @if (!string.IsNullOrEmpty(_userAvatar))
                                {
                                    <img class="avatar-menu-photo" src="@_userAvatar" alt="" />
                                }
                                else
                                {
                                    <span class="avatar-initial">@_userInitial</span>
                                }
                                <span class="avatar-menu-name">@_userFullName</span>
                            </div>
                            <NavLink href="@ProfileRoute" class="avatar-menu-item" role="menuitem" @onclick="CloseAvatarMenu">
                                <span class="nav-icon"><UiIcon Name="user-round" /></span>
                                <span>My Profile</span>
                            </NavLink>
                            <button type="button" class="avatar-menu-item logout" role="menuitem" @onclick="OpenLogoutModalFromMenu">
                                <span class="nav-icon"><UiIcon Name="log-out" /></span>
                                <span>Logout</span>
                            </button>
                        </div>
                        <div class="search-backdrop" @onclick="CloseAvatarMenu"></div>
                    }
                </div>
            </div>
        </header>

        <!-- Page content -->
        <main class="page-content">
            @Body
        </main>
    </div>
</div>
    </Authorized>
    <NotAuthorized>
        @if (!AuthService.IsInitialized)
        {
            <div class="app-container @(_sidebarCollapsed ? "sidebar-collapsed" : "")">
                <aside class="sidebar @(_sidebarOpen ? "open" : "")">
                    <div class="sidebar-header">
                        <div class="logo">
                            <span class="logo-icon brand-sphere"><img src="/images/unisphar-sphere-64.png" alt="UniSphere" /></span>
                            <span class="logo-text">UniSphere <span class="logo-plus">360+</span></span>
                        </div>
                        <button class="sidebar-close" @onclick="() => _sidebarOpen = false" aria-label="Close sidebar"><UiIcon Name="x" /></button>
                    </div>

                    <nav class="sidebar-nav">
                        <RoleNavMenu Role="@_userRole" SidebarClosed="() => _sidebarOpen = false" />
                    </nav>

                    <div class="sidebar-section sidebar-pinned">
                        <div class="sidebar-section-title">Quick Links</div>
                        <NavLink href="@ProfileRoute" class="nav-item" @onclick="() => _sidebarOpen = false">
                            <span class="nav-icon"><UiIcon Name="user-round" /></span>
                            <span>My Profile</span>
                        </NavLink>
                        <NavLink href="/notifications" class="nav-item" @onclick="() => _sidebarOpen = false">
                            <span class="nav-icon"><UiIcon Name="bell" /></span>
                            <span>Notifications</span>
                        </NavLink>
                        <NavLink href="/settings" class="nav-item" @onclick="() => _sidebarOpen = false">
                            <span class="nav-icon"><UiIcon Name="settings" /></span>
                            <span>Settings</span>
                        </NavLink>
                        <NavLink href="/help" class="nav-item" @onclick="() => _sidebarOpen = false">
                            <span class="nav-icon"><UiIcon Name="circle-help" /></span>
                            <span>Help & Support</span>
                        </NavLink>
                        <button class="nav-item logout-btn sidebar-logout" @onclick="OpenLogoutModal" title="Log out" aria-label="Log out">
                            <span class="nav-icon"><UiIcon Name="log-out" /></span>
                            <span>Logout</span>
                        </button>
                    </div>

                    <div class="sidebar-footer">
                        @if (!string.IsNullOrEmpty(_userFullName))
                        {
                            <div class="sidebar-user">
                                <span class="sidebar-user-avatar">@if (!string.IsNullOrEmpty(_userAvatar)) { <img src="@_userAvatar" alt="@_userFullName" /> } else { @_userInitial }</span>
                                <span class="sidebar-user-meta">
                                    <span class="sidebar-user-name">@_userFullName</span>
                                    @if (!string.IsNullOrEmpty(_userRole))
                                    {
                                        <span class="sidebar-user-role">@_userRole</span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                </aside>

                <div class="main-content">
                    <main class="page-content">
                        <div class="auth-loading" role="status">
                            <span class="search-spinner" aria-hidden="true"></span>
                            <span>Loading&hellip;</span>
                        </div>
                    </main>
                </div>
            </div>
        }
        else if (IsPublicPath())
        {
            <main class="page-content">
                @Body
            </main>
        }
    </NotAuthorized>
</AuthorizeView>

@if (_showLogoutModal)
{
    <div class="modal-overlay" @onclick="CancelLogoutModal">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="still-signed-in-title" @onclick:stopPropagation="true" @onkeydown="OnModalKeyDown">
            <div class="modal-header">
                <h3 id="still-signed-in-title">You're still signed in</h3>
            </div>
            <div class="modal-body">
                <p>You are already logged in as <strong>@(_userFullName ?? "this account")</strong>. Do you want to log out?</p>
            </div>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CancelLogoutModal" autofocus>Cancel</button>
                <button class="btn btn-danger" @onclick="ConfirmLogoutAsync">Log out</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _sidebarOpen = false;
    private bool _sidebarCollapsed;
    private bool _quickLinksCollapsed;
    private string _searchQuery = "";
    private int _unreadCount = 0;
    private string? _userAvatar;
    private string _userInitial = "?";
    private string? _userFullName;
    private string? _userRole;
    private bool _showLogoutModal;
    private bool _avatarMenuOpen;
    private bool _authBounced;
    private IJSObjectReference? _guardModule;
    private DotNetObjectReference<MainLayout>? _guardRef;
    private bool _guardActive;

    private bool _themeDark => ThemeService.Effective == "dark";

    private string ProfileRoute => _userRole?.ToLowerInvariant() switch
    {
        "graduate" => "/graduate/profile",
        "doctor" => "/doctor/profile",
        _ => "/profile"
    };

    private string AssistantRoute => _userRole?.ToLowerInvariant() switch
    {
        "student" => "/student/assistant",
        "graduate" => "/graduate/assistant",
        "doctor" => "/doctor/ai",
        _ => "/chat"
    };

    private ElementReference _searchInput;
    private List<SearchGroupDto> _searchGroups = new();
    private List<(string Group, SearchItemDto Item)> _flat = new();
    private bool _searchOpen;
    private bool _searchFocused;
    private bool _searchLoading;
    private string? _searchError;
    private int _selectedIndex = -1;
    private List<string> _recentSearches = new();
    private CancellationTokenSource? _searchCts;
    private IJSObjectReference? _searchModule;
    private DotNetObjectReference<MainLayout>? _searchRef;
    private const string RecentsKey = "unisphere.recentSearches";
    private bool _showRecents => _searchFocused && _searchQuery.Trim().Length == 0 && _recentSearches.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.Changed += OnThemeChanged;
        AuthService.AvatarChanged += OnAvatarChanged;
        var user = await AuthService.GetUserAsync();
        if (user is not null)
        {
            _userAvatar = user.AvatarUrl;
            _userFullName = user.FullName;
            _userRole = user.Role;
            _userInitial = string.IsNullOrEmpty(user.FullName) ? "?" : user.FullName[0].ToString().ToUpper();
        }
    }

    private bool IsPublicPath()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        return path is "" or "/login" or "/register";
    }

    private bool IsHomePath()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        return path is "" or "/" or "/dashboard";
    }

    protected override async Task OnParametersSetAsync()
    {        // Runs on every navigation (Body changes), so the badge refreshes
        // right after login instead of staying stale at 0.
        try
        {
            var count = await Http.GetFromJsonAsync<UniSphere.Api.Dtos.UnreadCountDto>("/api/notifications/unread-count");
            _unreadCount = count?.UnreadCount ?? 0;
        }
        catch
        {
            _unreadCount = 0;
        }

        try
        {
            var me = await AuthService.GetUserAsync();
            if (me is not null)
            {
                _userRole = me.Role;
                _userFullName = me.FullName;
                _userAvatar = me.AvatarUrl;
                _userInitial = string.IsNullOrEmpty(me.FullName) ? "?" : me.FullName[0].ToString().ToUpper();
            }
        }
        catch
        {
            // Stay with whatever identity we already have.
        }

        if (!IsPublicPath() && AuthService.IsInitialized && AuthService.GetToken() is null && !_authBounced)
        {
            _authBounced = true;
            Nav.NavigateTo("/login", replace: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _sidebarCollapsed = await JS.InvokeAsync<bool>("eval", "localStorage.getItem('unisphar.sidebar') === 'collapsed'");
                _quickLinksCollapsed = await JS.InvokeAsync<bool>("eval", "localStorage.getItem('unisphar.quicklinks') === 'collapsed'");
            }
            catch { }

            var restored = await AuthService.RestoreSessionAsync();
            if (restored)
            {
                await RefreshUserAsync();
                var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
                if (path is "/login" or "/register")
                    Nav.NavigateTo("/dashboard", replace: true);
                else
                    StateHasChanged();
            }
            else if (AuthService.IsInitialized && !IsPublicPath() && AuthService.GetToken() is null && !_authBounced)
            {
                _authBounced = true;
                Nav.NavigateTo("/login", replace: true);
            }
        }
        await SyncBackGuardAsync();
        if (firstRender)
        {
            await ThemeService.InitializeAsync();
            await LoadRecentSearchesAsync();
            await RegisterSearchKeysAsync();
            StateHasChanged();
        }
    }

    private async Task RefreshUserAsync()
    {
        try
        {
            var me = await AuthService.GetUserAsync();
            if (me is not null)
            {
                _userRole = me.Role;
                _userFullName = me.FullName;
                _userAvatar = me.AvatarUrl;
                _userInitial = string.IsNullOrEmpty(me.FullName) ? "?" : me.FullName[0].ToString().ToUpper();
            }
        }
        catch
        {
            // Stay with whatever identity we already have.
        }
        try
        {
            var count = await Http.GetFromJsonAsync<UniSphere.Api.Dtos.UnreadCountDto>("/api/notifications/unread-count");
            _unreadCount = count?.UnreadCount ?? 0;
        }
        catch
        {
            _unreadCount = 0;
        }
    }

    private async Task SyncBackGuardAsync()
    {
        var shouldArm = AuthService.IsInitialized
            && AuthService.GetToken() is not null
            && IsHomePath();
        if (shouldArm && !_guardActive)
        {
            try
            {
                _guardModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/backGuard.js");
                _guardRef = DotNetObjectReference.Create(this);
                await _guardModule.InvokeVoidAsync("startBackGuard", _guardRef);
                _guardActive = true;
            }
            catch
            {
                // JS unavailable: stay unguarded rather than break the page.
            }
        }
        else if (!shouldArm && _guardActive)
        {
            await StopBackGuardAsync();
        }
    }

    private async Task StopBackGuardAsync()
    {
        _guardActive = false;
        try
        {
            if (_guardModule is not null)
                await _guardModule.InvokeVoidAsync("stopBackGuard");
        }
        catch
        {
            // Listener is already gone (logout/dispose path).
        }
        _guardRef?.Dispose();
        _guardRef = null;
    }

    public async ValueTask DisposeAsync()
    {
        ThemeService.Changed -= OnThemeChanged;
        AuthService.AvatarChanged -= OnAvatarChanged;
        await StopBackGuardAsync();
        if (_guardModule is not null)
        {
            try
            {
                await _guardModule.DisposeAsync();
            }
            catch
            {
                // Module already released.
            }
        }
        try
        {
            if (_searchModule is not null)
                await _searchModule.InvokeVoidAsync("unregisterSearchKeys");
        }
        catch
        {
            // Listener already gone.
        }
        _searchRef?.Dispose();
        _searchRef = null;
        if (_searchModule is not null)
        {
            try
            {
                await _searchModule.DisposeAsync();
            }
            catch
            {
                // Module already released.
            }
        }
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }

    [JSInvokable]
    public Task OnBackPressed()
    {
        if (!AuthService.IsInitialized || AuthService.GetToken() is null || !IsHomePath())
            return Task.CompletedTask;
        _showLogoutModal = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OpenLogoutModal()
    {
        if (AuthService.IsLoading)
        {
            _showLogoutModal = true;
            return;
        }
        var user = await AuthService.GetUserAsync();
        if (user is null && AuthService.GetToken() is null)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }
        if (user is not null)
            _userFullName = user.FullName;
        _showLogoutModal = true;
    }

    private void CancelLogoutModal() => _showLogoutModal = false;

    private void ToggleAvatarMenu() => _avatarMenuOpen = !_avatarMenuOpen;

    private void CloseAvatarMenu() => _avatarMenuOpen = false;

    private async Task OpenLogoutModalFromMenu()
    {
        _avatarMenuOpen = false;
        await OpenLogoutModal();
    }

    private void OnModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CancelLogoutModal();
    }

    private async Task ConfirmLogoutAsync()
    {
        _showLogoutModal = false;
        await AuthService.LogoutAsync();
        await StopBackGuardAsync();
        Nav.NavigateTo("/login", replace: true);
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(_searchQuery)}");
        }
    }

    private async Task ToggleSidebarAsync()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        try
        {
            var value = _sidebarCollapsed ? "collapsed" : "expanded";
            await JS.InvokeVoidAsync("eval", $"localStorage.setItem('unisphar.sidebar', '{value}')");
        }
        catch { }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleQuickLinksAsync()
    {
        _quickLinksCollapsed = !_quickLinksCollapsed;
        try
        {
            var value = _quickLinksCollapsed ? "collapsed" : "expanded";
            await JS.InvokeVoidAsync("eval", $"localStorage.setItem('unisphar.quicklinks', '{value}')");
        }
        catch { }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleThemeAsync()
    {
        await ThemeService.ToggleAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnAvatarChanged(string? url)
    {
        _userAvatar = string.IsNullOrWhiteSpace(url) ? null : url;
        _ = InvokeAsync(StateHasChanged);
    }

    private void SearchFocused()
    {
        _searchFocused = true;
        _selectedIndex = -1;
        if (_showRecents || _searchQuery.Trim().Length > 0)
            _searchOpen = true;
    }

    private void SearchBlurred()
    {
        _searchFocused = false;
        CloseSearch();
    }

    private void CloseSearch() => _searchOpen = false;

    private async Task SearchTextChangedAsync()
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        _selectedIndex = -1;
        var term = _searchQuery.Trim();

        if (term.Length < 2)
        {
            _searchGroups = new();
            _flat = new();
            _searchLoading = false;
            _searchError = null;
            _searchOpen = _searchFocused && (term.Length > 0 || _recentSearches.Count > 0);
            return;
        }

        _searchOpen = true;
        _searchLoading = true;
        _searchError = null;
        try
        {
            await Task.Delay(300, token);
            var result = await Http.GetFromJsonAsync<SearchResponseDto>(
                $"/api/search?q={Uri.EscapeDataString(term)}&take=20", token);
            if (token.IsCancellationRequested) return;
            _searchGroups = result?.Groups.ToList() ?? new();
            _flat = _searchGroups
                .SelectMany(g => g.Items.Select(i => (g.Label, Item: i)))
                .ToList();
        }
        catch (TaskCanceledException)
        {
            return;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            // Stay quiet: the layout auth gate owns session expiry.
            _searchOpen = false;
            return;
        }
        catch
        {
            _searchError = "Search failed. Please try again.";
        }
        finally
        {
            _searchLoading = false;
        }
    }

    private async Task SearchKeyDown(KeyboardEventArgs e)
    {
        if (!_searchOpen) return;
        if (e.Key == "Escape")
        {
            CloseSearch();
        }
        else if (e.Key == "ArrowDown")
        {
            _selectedIndex = _flat.Count == 0 ? -1 : Math.Min(_selectedIndex + 1, _flat.Count - 1);
        }
        else if (e.Key == "ArrowUp")
        {
            _selectedIndex = Math.Max(_selectedIndex - 1, -1);
        }
        else if (e.Key == "Enter")
        {
            if (_selectedIndex >= 0 && _selectedIndex < _flat.Count)
                await SelectResultAsync(_flat[_selectedIndex].Item);
            else if (_searchQuery.Trim().Length >= 2)
            {
                await AddRecentSearchAsync(_searchQuery.Trim());
                CloseSearch();
                Nav.NavigateTo("/search?q=" + Uri.EscapeDataString(_searchQuery.Trim()));
            }
        }
    }

    private async Task SelectResultAsync(SearchItemDto item)
    {
        await AddRecentSearchAsync(_searchQuery.Trim());
        CloseSearch();
        _selectedIndex = -1;
        Nav.NavigateTo(item.Route);
    }

    private async Task SearchRecentAsync(string term)
    {
        _searchQuery = term;
        _searchOpen = true;
        await SearchTextChangedAsync();
        try
        {
            _searchModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/search.js");
            await _searchModule.InvokeVoidAsync("focusElement", "topbar-search");
        }
        catch
        {
            // Focus helper unavailable: results still load.
        }
    }

    private async Task AddRecentSearchAsync(string term)
    {
        if (string.IsNullOrWhiteSpace(term)) return;
        _recentSearches.RemoveAll(s => string.Equals(s, term, StringComparison.OrdinalIgnoreCase));
        _recentSearches.Insert(0, term);
        _recentSearches = _recentSearches.Take(5).ToList();
        try
        {
            await BrowserStorage.SetAsync(RecentsKey, _recentSearches);
        }
        catch
        {
            // Recents are best-effort.
        }
    }

    private async Task LoadRecentSearchesAsync()
    {
        try
        {
            var stored = await BrowserStorage.GetAsync<List<string>>(RecentsKey);
            if (stored.Success && stored.Value is not null)
                _recentSearches = stored.Value.Take(5).ToList();
        }
        catch
        {
            // No recents without JS interop.
        }
    }

    private async Task RegisterSearchKeysAsync()
    {
        try
        {
            _searchModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/search.js");
            _searchRef = DotNetObjectReference.Create(this);
            await _searchModule.InvokeVoidAsync("registerSearchKeys", _searchRef);
        }
        catch
        {
            // Shortcuts unavailable: the input still works.
        }
    }

    [JSInvokable]
    public async Task FocusSearch()
    {
        try
        {
            _searchModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/search.js");
            await _searchModule.InvokeVoidAsync("focusElement", "topbar-search");
        }
        catch
        {
            // Focus helper unavailable; the input still works by click.
        }
        // Focusing fires @onfocus which opens recents; force a render anyway.
        _searchFocused = true;
        if (_showRecents || _searchQuery.Trim().Length > 0)
            _searchOpen = true;
        StateHasChanged();
    }

    private static Microsoft.AspNetCore.Components.MarkupString Highlight(string text, string term)
    {
        var index = string.IsNullOrWhiteSpace(term)
            ? -1
            : text.IndexOf(term.Trim(), StringComparison.OrdinalIgnoreCase);
        if (index < 0)
            return new(System.Net.WebUtility.HtmlEncode(text));
        return new(System.Net.WebUtility.HtmlEncode(text[..index])
            + "<mark>" + System.Net.WebUtility.HtmlEncode(text.Substring(index, term.Trim().Length)) + "</mark>"
            + System.Net.WebUtility.HtmlEncode(text[(index + term.Trim().Length)..]));
    }
}
