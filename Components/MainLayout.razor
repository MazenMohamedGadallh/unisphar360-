@inherits LayoutComponentBase
@implements IAsyncDisposable
@using System.Net
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS
@inject ThemeService ThemeService
@inject ProtectedLocalStorage BrowserStorage
@inject UniSphere.Api.Services.BlazorAuthService AuthService

<AuthorizeView>
    <Authorized>
<div class="app-container">    <!-- Sidebar -->
    <aside class="sidebar @(_sidebarOpen ? "open" : "")">
        <div class="sidebar-header">
            <div class="logo">
                <span class="logo-icon">&#9670;</span>
                <span class="logo-text">UniSphere <span class="logo-plus">360+</span></span>
            </div>
            <button class="sidebar-close" @onclick="() => _sidebarOpen = false">&times;</button>
        </div>

        <nav class="sidebar-nav">
            <NavLink href="/dashboard" class="nav-item" @onclick="() => _sidebarOpen = false">
                <span class="nav-icon">&#8962;</span>
                <span>Home</span>
            </NavLink>
            <NavLink href="/academic-advisor" class="nav-item" @onclick="() => _sidebarOpen = false">
                <span class="nav-icon">&#127891;</span>
                <span>Academic Advisor</span>
            </NavLink>
            <NavLink href="/career-assistant" class="nav-item" @onclick="() => _sidebarOpen = false">
                <span class="nav-icon">&#128188;</span>
                <span>Career Assistant</span>
            </NavLink>
            <NavLink href="/research-hub" class="nav-item" @onclick="() => _sidebarOpen = false">
                <span class="nav-icon">&#128269;</span>
                <span>Research Hub</span>
            </NavLink>
            @if (_userRole is "Student" or "Graduate" or "Doctor")
            {
                <NavLink href="/university" class="nav-item" @onclick="() => _sidebarOpen = false">
                    <span class="nav-icon">&#127979;</span>
                    <span>My University</span>
                </NavLink>
            }
            <NavLink href="/student-services" class="nav-item" @onclick="() => _sidebarOpen = false">
                <span class="nav-icon">&#127974;</span>
                <span>Student Services</span>
            </NavLink>
            @if (_userRole is "Student" or "Graduate")
            {
                <NavLink href="/analytics" class="nav-item" @onclick="() => _sidebarOpen = false">
                    <span class="nav-icon">&#128200;</span>
                    <span>My Analytics</span>
                </NavLink>
            }
            @if (_userRole == "Admin")
            {
                <NavLink href="/admin" class="nav-item" @onclick="() => _sidebarOpen = false">
                    <span class="nav-icon">&#128202;</span>
                    <span>Admin Panel</span>
                </NavLink>
            }
            @if (_userRole == "Doctor")
            {
                <NavLink href="/doctor" class="nav-item" @onclick="() => _sidebarOpen = false">
                    <span class="nav-icon">&#128202;</span>
                    <span>Doctor Dashboard</span>
                </NavLink>
                <NavLink href="/doctor/courses" class="nav-item" @onclick="() => _sidebarOpen = false">
                    <span class="nav-icon">&#128218;</span>
                    <span>My Courses</span>
                </NavLink>
                <NavLink href="/doctor/ai" class="nav-item" @onclick="() => _sidebarOpen = false">
                    <span class="nav-icon">&#129302;</span>
                    <span>Teaching Assistant</span>
                </NavLink>
            }
            <NavLink href="/chat" class="nav-item" @onclick="() => _sidebarOpen = false">
                <span class="nav-icon">&#128241;</span>
                <span>AI Assistant</span>
            </NavLink>
        </nav>

        <div class="sidebar-section sidebar-pinned">
            <div class="sidebar-section-title">Quick Links</div>
            <NavLink href="/profile" class="nav-item" @onclick="() => _sidebarOpen = false">
                <span class="nav-icon">&#128100;</span>
                <span>My Profile</span>
            </NavLink>
            <NavLink href="/notifications" class="nav-item" @onclick="() => _sidebarOpen = false">
                <span class="nav-icon">&#128276;</span>
                <span>Notifications</span>
            </NavLink>
            <NavLink href="/settings" class="nav-item" @onclick="() => _sidebarOpen = false">
                <span class="nav-icon">&#9881;</span>
                <span>Settings</span>
            </NavLink>
            <NavLink href="/help" class="nav-item" @onclick="() => _sidebarOpen = false">
                <span class="nav-icon">&#10067;</span>
                <span>Help & Support</span>
            </NavLink>
            <button class="nav-item logout-btn sidebar-logout" @onclick="OpenLogoutModal" title="Log out" aria-label="Log out">
                <span class="nav-icon">&#128682;</span>
                <span>Logout</span>
            </button>
        </div>

        <div class="sidebar-footer">
            @if (!string.IsNullOrEmpty(_userFullName))
            {
                <div class="sidebar-user">
                    <span class="sidebar-user-avatar">@_userInitial</span>
                    <span class="sidebar-user-name">@_userFullName</span>
                </div>
            }
        </div>
    </aside>

    <!-- Main content -->
    <div class="main-content">
        <!-- Top bar -->
        <header class="top-bar">
            <button class="menu-toggle" @onclick="() => _sidebarOpen = !_sidebarOpen">&#9776;</button>

            <div class="search-wrap" @onkeydown="SearchKeyDown">
                <div class="search-box">
                    <span class="search-icon">&#128269;</span>
                    <input id="topbar-search" type="text" placeholder="Search courses, events, modules..."
                           @bind="_searchQuery" @bind:event="oninput" @bind:after="SearchTextChangedAsync"
                           @onfocus="SearchFocused" @onblur="SearchBlurred" @ref="_searchInput"
                           autocomplete="off" role="combobox" aria-expanded="@_searchOpen" aria-label="Search" aria-controls="topbar-search-list" />
                    @if (_searchLoading)
                    {
                        <span class="search-spinner" aria-hidden="true"></span>
                    }
                </div>
                @if (_searchOpen)
                {
                    <div class="search-dropdown" id="topbar-search-list" role="listbox" aria-label="Search results">
                        @if (!string.IsNullOrEmpty(_searchError))
                        {
                            <div class="alert alert-error search-alert">@_searchError</div>
                        }
                        else if (_showRecents)
                        {
                            <div class="search-group-label">Recent searches</div>
                            @foreach (var recent in _recentSearches)
                            {
                                <div class="search-item" @onmousedown:preventDefault @onclick="() => SearchRecentAsync(recent)">
                                    <span class="search-item-icon">&#128339;</span>
                                    <span class="search-item-text">@recent</span>
                                </div>
                            }
                        }
                        else if (_searchQuery.Trim().Length < 2)
                        {
                            <div class="empty-state">Type at least 2 characters to search.</div>
                        }
                        else if (!_flat.Any() && !_searchLoading)
                        {
                            <div class="empty-state">No results for "@_searchQuery".</div>
                        }
                        else
                        {
                            var lastGroup = "";
                            var flatIndex = -1;
                            @foreach (var entry in _flat)
                            {
                                flatIndex++;
                                var fi = flatIndex;
                                @if (entry.Group != lastGroup)
                                {
                                    lastGroup = entry.Group;
                                    <div class="search-group-label">@entry.Group</div>
                                }
                                <div role="option" aria-selected="@(fi == _selectedIndex)"
                                     class="search-item @(fi == _selectedIndex ? "selected" : "")"
                                     @onmousedown:preventDefault @onclick="() => SelectResultAsync(entry.Item)">
                                    <span class="search-item-icon">@entry.Item.Icon</span>
                                    <span class="search-item-text">@Highlight(entry.Item.Title, _searchQuery)<small>@entry.Item.Subtitle</small></span>
                                </div>
                            }
                        }
                    </div>
                    <div class="search-backdrop" @onclick="CloseSearch"></div>
                }
            </div>

            <div class="top-bar-actions">
                <button type="button" class="icon-btn theme-toggle" title="Dark mode"
                        aria-label="@(_themeDark ? "Switch to light mode" : "Switch to dark mode")"
                        @onclick="ToggleThemeAsync">
                    @(_themeDark ? "☀" : "🌙")
                </button>
                <NavLink href="/chat" class="icon-btn" title="AI Assistant">
                    &#128241;
                </NavLink>
                <NavLink href="/notifications" class="icon-btn" title="Notifications">
                    &#128276;
                    @if (_unreadCount > 0)
                    {
                        <span class="badge">@_unreadCount</span>
                    }
                </NavLink>
                <div class="avatar-wrap">
                    <button type="button" class="user-avatar" title="Account"
                            aria-label="Account menu" aria-expanded="@_avatarMenuOpen"
                            @onclick="ToggleAvatarMenu">
                        @if (!string.IsNullOrEmpty(_userAvatar))
                        {
                            <img src="@_userAvatar" alt="Profile" />
                        }
                        else
                        {
                            <span class="avatar-initial">@_userInitial</span>
                        }
                    </button>
                    @if (_avatarMenuOpen)
                    {
                        <div class="avatar-menu" role="menu" aria-label="Account">
                            <div class="avatar-menu-user">
                                <span class="avatar-initial">@_userInitial</span>
                                <span class="avatar-menu-name">@_userFullName</span>
                            </div>
                            <NavLink href="/profile" class="avatar-menu-item" role="menuitem" @onclick="CloseAvatarMenu">
                                <span class="nav-icon">&#128100;</span>
                                <span>My Profile</span>
                            </NavLink>
                            <button type="button" class="avatar-menu-item logout" role="menuitem" @onclick="OpenLogoutModalFromMenu">
                                <span class="nav-icon">&#128682;</span>
                                <span>Logout</span>
                            </button>
                        </div>
                        <div class="search-backdrop" @onclick="CloseAvatarMenu"></div>
                    }
                </div>
            </div>
        </header>

        <!-- Page content -->
        <main class="page-content">
            @Body
        </main>
    </div>
</div>
    </Authorized>
