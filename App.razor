<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>UniSphere 360+</title>
    <base href="/" />
    <link rel="stylesheet" href="@($"css/app.legacy.css?v={Version("css/app.legacy.css")}")" />
    <link rel="stylesheet" href="@($"css/app.generated.css?v={Version("css/app.generated.css")}")" />
    <link rel="icon" type="image/png" href="/images/unisphar-sphere-64.png" />
    <component type="typeof(HeadOutlet)" rendermode="InteractiveServer" />
    <script>
        // Apply the saved (or system) theme before first paint: no white flash.
        (function () {
            try {
                var stored = localStorage.getItem("theme");
                var theme = (stored === "light" || stored === "dark") ? stored :
                    (stored === "system" ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : "dark");
                document.documentElement.dataset.theme = theme;
            } catch (e) { /* private mode: stay light */ }
        })();
    </script>
</head>
<body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs><linearGradient id="ui-duo" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#E4D9FF"/><stop offset="0.55" stop-color="#B9A2F8"/><stop offset="1" stop-color="#8F6CEB"/></linearGradient></defs></svg>
    <Routes @rendermode="@RenderMode.InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    [Inject] private IWebHostEnvironment Env { get; set; } = default!;

    // The file's own timestamp: browsers fetch a fresh copy whenever the CSS changes.
    private string Version(string path) =>
        File.GetLastWriteTimeUtc(Path.Combine(Env.WebRootPath, path)).Ticks.ToString();
}
