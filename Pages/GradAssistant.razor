@page "/graduate/assistant"
@inherits UniSphere.Api.Components.GradPageBase

<PageTitle>AI Career Assistant - UniSphere 360+</PageTitle>

<div class="page-header">
    <h1>AI Career Assistant</h1>
    <p>Chat about your career — it knows your profile, target roles and job activity</p>
</div>

@if (_ready)
{
    <div class="card" style="height:640px; display:flex; flex-direction:column;">
        <ChatPanel ElementId="grad-chat-messages" ShowConversations="false" />
    </div>
}
else if (_error is not null)
{
    <div class="alert alert-error">@_error</div>
}

@code {
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        if (!await GuardGraduateAsync()) return;
        _ready = true;
        StateHasChanged();
    }
}
