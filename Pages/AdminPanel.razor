    }

    private async Task SearchUsersAsync()
    {
        _userPage = 1;
        await LoadUsersAsync();
    }

    private async Task ChangeUserPageAsync(int delta)
    {
        _userPage = Math.Max(1, _userPage + delta);
        await LoadUsersAsync();
    }

    private async Task ChangeAuditPageAsync(int delta)
    {
        _auditPage = Math.Max(1, _auditPage + delta);
        await LoadAuditAsync();
    }

    private void Ask(string title, string message, Func<Task> action)
    {
        _confirmTitle = title;
        _confirmMessage = message;
        _confirmAction = action;
    }

    private void CancelConfirm()
    {
        _confirmTitle = null;
        _confirmMessage = null;
        _confirmAction = null;
    }

    private void OnConfirmKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CancelConfirm();
    }

    private async Task RunConfirmAsync()
    {
        var action = _confirmAction;
        CancelConfirm();
        if (action is not null) await action();
    }

    // ---- Locked account fields edit dialog ----

    private async Task OpenEditUserAsync(AdminUserDto u)
    {
        _editUserError = null;
        try
        {
            if (_editUniversities is null)
                _editUniversities = await Http.GetFromJsonAsync<List<UniversityDto>>("/api/auth/universities") ?? new();

            var detail = await Http.GetFromJsonAsync<AdminUserDetailDto>($"/api/admin/users/{u.Id}");
            if (detail is null)
            {
                Toast("Could not load that account.", true);
                return;
            }
            _editUser = new AdminUserEditForm
            {
                Id = detail.Id,
                Role = detail.Role,
                FirstName = detail.FirstName,
                MiddleName = detail.MiddleName ?? "",
                LastName = detail.LastName,
                Email = detail.Email,
                PhoneNumber = detail.PhoneNumber,
                Address = detail.Address,
                Department = detail.Department,
                UniversityId = detail.UniversityId?.ToString() ?? ""
            };
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            await AuthService.LogoutAsync();
            Nav.NavigateTo("/login?expired=1");
        }
        catch
        {
            Toast("Could not load that account. Please try again.", true);
        }
    }

    private void CloseEditUser()
    {
        _editUser = null;
        _editUserError = null;
    }

    private void OnEditKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseEditUser();
    }

    private async Task SaveUserAsync()
    {
        if (_editUser is null || _savingUser) return;
        _editUserError = null;

        if (string.IsNullOrWhiteSpace(_editUser.FirstName)
            || string.IsNullOrWhiteSpace(_editUser.LastName)
            || string.IsNullOrWhiteSpace(_editUser.Email)
            || string.IsNullOrWhiteSpace(_editUser.PhoneNumber))
        {
            _editUserError = "First name, last name, email and phone number are required.";
            return;
        }

        _savingUser = true;
        try
        {
            int? universityId = int.TryParse(_editUser.UniversityId, out var uid) ? uid : null;
            var response = await Http.PutAsJsonAsync($"/api/admin/users/{_editUser.Id}", new
            {
                firstName = _editUser.FirstName.Trim(),
                middleName = string.IsNullOrWhiteSpace(_editUser.MiddleName) ? null : _editUser.MiddleName.Trim(),
                lastName = _editUser.LastName.Trim(),
                email = _editUser.Email.Trim(),
                phoneNumber = _editUser.PhoneNumber.Trim(),
                address = string.IsNullOrWhiteSpace(_editUser.Address) ? null : _editUser.Address.Trim(),
                department = string.IsNullOrWhiteSpace(_editUser.Department) ? null : _editUser.Department.Trim(),
                universityId
            });

            if (response.IsSuccessStatusCode)
            {
                Toast("Account details updated.");
                CloseEditUser();
                await LoadUsersAsync();
            }
            else if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                await AuthService.LogoutAsync();
                Nav.NavigateTo("/login?expired=1");
            }
            else
            {
                var text = await response.Content.ReadAsStringAsync();
                _editUserError = string.IsNullOrWhiteSpace(text)
                    ? $"Could not update the account ({(int)response.StatusCode})."
                    : text;
            }
        }
        catch
        {
            _editUserError = "Could not update the account. Check your connection and try again.";
        }
        finally
        {
            _savingUser = false;
        }
    }

