    // ---- Instructor assignments tab ----

    private async Task LoadInstructorsAsync()
    {
        await GuardedLoadAsync(async () =>
        {
            if (_universities is null)
                _universities = await Http.GetFromJsonAsync<List<UniversityDto>>("/api/auth/universities") ?? new();
        });
        await LoadAssignmentOptionsAsync();
        await LoadAssignmentsAsync();
    }

    private async Task LoadAssignmentOptionsAsync()
    {
        if (!HasAssignmentOptions)
        {
            _assignCourses = new();
            _assignDoctors = new();
            return;
        }

        var universityId = _assignUniversityId;
        await GuardedLoadAsync(async () =>
        {
            _assignCourses = await Http.GetFromJsonAsync<List<AdminCourseDto>>(
                $"/api/admin/courses?universityId={universityId}") ?? new();
            _assignDoctors = await Http.GetFromJsonAsync<List<AdminDoctorDto>>(
                $"/api/admin/doctors?universityId={universityId}") ?? new();
        });
    }

    private Task LoadAssignmentsAsync()
    {
        var query = "/api/admin/instructor-assignments";
        if (!string.IsNullOrEmpty(_assignUniversityId))
            query += $"?universityId={_assignUniversityId}";
        return GuardedLoadAsync(async () =>
            _assignments = await Http.GetFromJsonAsync<List<InstructorAssignmentDto>>(query) ?? new());
    }

    private async Task SelectAssignUniversityAsync(string? value)
    {
        _assignUniversityId = value ?? "";
        _assignCourseId = "";
        _assignDoctorId = "";
        await LoadAssignmentOptionsAsync();
        await LoadAssignmentsAsync();
    }

    private async Task AssignDoctorAsync()
    {
        if (_assigning) return;
        if (!int.TryParse(_assignCourseId, out var courseId)
            || !int.TryParse(_assignDoctorId, out var doctorId)
            || string.IsNullOrWhiteSpace(_assignTerm))
        {
            Toast("Choose a course, a doctor and a term first.", true);
            return;
        }

        _assigning = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/admin/instructor-assignments",
                new { courseId, doctorUserId = doctorId, term = _assignTerm.Trim() });
            if (response.IsSuccessStatusCode)
            {
                Toast("Doctor assigned to the course.");
                _assignCourseId = "";
                _assignDoctorId = "";
                await LoadAssignmentsAsync();
            }
            else
            {
                Toast($"Could not assign the doctor: {await response.Content.ReadAsStringAsync()}", true);
            }
        }
        catch
        {
            Toast("Could not assign the doctor. Check your connection and try again.", true);
        }
        finally
        {
            _assigning = false;
        }
    }

    private void AskRemoveAssignmentAsync(InstructorAssignmentDto a) => Ask(
        "Remove assignment",
        $"Remove {a.DoctorName} from {a.CourseCode} \u2014 {a.CourseTitle} ({a.Term})?",
        async () =>
        {
            var response = await Http.DeleteAsync($"/api/admin/instructor-assignments/{a.Id}");
            if (response.IsSuccessStatusCode)
            {
                Toast($"{a.DoctorName} removed from {a.CourseCode}.");
                await LoadAssignmentsAsync();
            }
            else
            {
                Toast($"Could not remove the assignment: {await response.Content.ReadAsStringAsync()}", true);
            }
        });

    private async Task SearchUsersKeyUpAsync(KeyboardEventArgs e)
