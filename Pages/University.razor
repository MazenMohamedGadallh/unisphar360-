@page "/university"
@attribute [Authorize(Roles = "Student")]
@*
[Authorize] removed on purpose (see Dashboard.razor): the server
challenges every F5 to /login because the browser never sends the
localStorage JWT as a bearer header. /api stays [Authorize]-guarded
and MainLayout bounces anonymous users to /login after auth resolves.
*@
@using System.Net
@using Microsoft.JSInterop
@using UniSphere.Api.Dtos
@using UniSphere.Api.Services
@inject HttpClient Http
@inject NavigationManager Nav
@inject BlazorAuthService AuthService
@inject IJSRuntime JS

<PageTitle>My University - UniSphere 360+</PageTitle>

<div class="page-header">
    <h1>My University</h1>
    <p>@(_info?.UniversityName ?? "Course materials and summaries")</p>
</div>

@if (!string.IsNullOrEmpty(_downloadError))
{
    <div class="alert alert-error">
        @_downloadError
        <button class="btn btn-small" @onclick="() => _downloadError = null">Dismiss</button>
    </div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-error">@_error <button class="btn btn-small" @onclick="ReloadAsync">Retry</button></div>
}
else if (_loading && _info is null)
{
    <div class="loading">Loading university...</div>
}
else if (_info is not null && string.IsNullOrEmpty(_info.UniversityName))
{
    <div class="empty-state">No university assigned to your account yet.</div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h3>Courses</h3>
            <span class="rec-track">@(_courses is null ? "All courses" : $"{_courses.Count} in your university")</span>
        </div>
        @if (_courses is null)
        {
            <div class="loading">Loading courses...</div>
        }
        else
        {
            var visibleCourses = VisibleCourses.ToList();
            <div class="uni-course-filters">
                <div class="form-group">
                    <label for="courseDepartment">Department</label>
                    <select id="courseDepartment" @bind="_departmentFilter">
                        <option value="">All departments</option>
                        @foreach (var dept in Departments)
                        {
                            <option value="@dept" dir="auto">@dept</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="courseYear">Year</label>
                    <select id="courseYear" @bind="_yearFilter">
                        <option value="">All years</option>
                        @foreach (var year in Years)
                        {
                            <option value="@year">Year @year</option>
                        }
                    </select>
                </div>
                <div class="form-group uni-course-search">
                    <label for="courseSearch">Search</label>
                    <input id="courseSearch" type="search" @bind="_courseSearch" @bind:event="oninput"
                           placeholder="Course name or code..." dir="auto" />
                </div>
            </div>
            <div class="uni-course-summary">Showing @visibleCourses.Count of @_courses.Count courses</div>
            @if (!_courses.Any())
            {
                <div class="empty-state"><div class="empty-icon"><UiIcon Name="book-open" /></div>No courses are available for your university yet.</div>
            }
            else if (visibleCourses.Count == 0)
            {
                <div class="empty-state"><div class="empty-icon"><UiIcon Name="search" /></div>No courses match the current filters.</div>
            }
            else
            {
                <div class="uni-course-list">
                    @foreach (var course in visibleCourses)
                    {
                        <div class="uni-course-item">
                            <div class="rec-info">
                                <span class="rec-code">@course.Code</span>
                                <span class="uni-course-name" dir="auto">@course.Title</span>
                                <span class="rec-track" dir="auto">
                                    @(string.IsNullOrWhiteSpace(course.Department) ? "All departments" : course.Department)
                                    &middot; Year @(course.AcademicYear?.ToString() ?? "-")
                                    &middot; @course.Semester
                                </span>
                                @if (!string.IsNullOrWhiteSpace(course.Instructors))
                                {
                                    <span class="rec-track" dir="auto">Instructor: @course.Instructors</span>
                                }
                                @if (course.MatchesStudentDepartmentYear)
                                {
                                    <span class="rec-track">Matches your department/year</span>
                                }
                            </div>
                            <div class="uni-course-actions">
                                <span class="status-badge @StatusClass(course.Status)">@course.Status</span>
                                <span class="rec-track">@course.MaterialsCount material@(course.MaterialsCount == 1 ? "" : "s")</span>
                                <NavLink href="@($"/courses/{course.Id}")" class="rec-btn">Open</NavLink>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <div class="card">
        <div class="card-header"><h3>Materials</h3></div>
        <div class="form-inline">
            <div class="form-group">
                <label for="courseFilter">Course</label>
                <select id="courseFilter" @bind="_courseId" @bind:after="ApplyFiltersAsync">
                    <option value="">All courses</option>
                    @if (_courses is not null)
                    {
                        @foreach (var c in _courses)
                        {
                            <option value="@c.Id">@c.Title (@c.MaterialsCount)@(!string.IsNullOrWhiteSpace(c.Instructors) ? $" - {c.Instructors}" : "")</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="typeFilter">Type</label>
                <select id="typeFilter" @bind="_type" @bind:after="ApplyFiltersAsync">
                    <option value="">All types</option>
                    @foreach (var t in MaterialTypes)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="materialSearch">Search</label>
                <input id="materialSearch" @bind="_search" @bind:event="oninput" @onkeyup="SearchKeyUpAsync" placeholder="Title or description..." />
            </div>
        </div>
        @if (_materials is null)
        {
            <div class="loading">Loading materials...</div>
        }
        else if (!_materials.Any())
        {
            <div class="empty-state"><div class="empty-icon"><UiIcon Name="file-text" /></div>No materials match the current filters.</div>
        }
        else
        {
            <div class="recommendation-list">
                @foreach (var m in _materials)
                {
                    <div class="recommendation-item @(_detail?.Id == m.Id ? "selected" : "")" @onclick="() => OpenMaterialAsync(m)">
                        <div class="rec-info">
                            <span class="rec-code">@m.Type</span>
                            <span class="rec-title">@m.Title</span>
                            <span class="rec-track">
                                @m.CourseName
                                @if (!string.IsNullOrWhiteSpace(m.InstructorName))
                                {
                                    <text> &middot; @m.InstructorName</text>
                                }
                                &middot; @m.CreatedAt.ToString("MMM d, yyyy")
                            </span>
                        </div>
                        @if (m.HasUploadedFile)
                        {
                            <button type="button" class="rec-btn" @onclick="() => DownloadAttachmentAsync(m)"
                                    @onclick:stopPropagation="true" disabled="@_downloading">Download</button>
                        }
                        <button type="button" class="rec-btn" @onclick="() => OpenMaterialAsync(m)" @onclick:stopPropagation="true">Open</button>
                    </div>
                }
            </div>
            <div class="pagination">
                <button class="btn btn-sm btn-secondary" disabled="@(_page <= 1)" @onclick="() => ChangePageAsync(-1)">Prev</button>
                <span>Page @_page of @TotalPages (@_total total)</span>
                <button class="btn btn-sm btn-secondary" disabled="@(_page >= TotalPages)" @onclick="() => ChangePageAsync(1)">Next</button>
            </div>
        }
    </div>

    @if (_detailOpen)
    {
        <div class="modal-overlay" @onclick="CloseMaterialDetail">
            <div class="modal" role="dialog" aria-modal="true" aria-labelledby="material-detail-title" @onkeydown="OnDetailKeyDown" @onclick:stopPropagation="true">
                @if (_detailLoading)
                {
                    <div class="modal-body"><div class="loading">Loading material...</div></div>
                }
                else if (!string.IsNullOrEmpty(_detailError))
                {
                    <div class="modal-body"><div class="alert alert-error">@_detailError</div></div>
                    <div class="modal-actions">
                        <button class="btn btn-secondary" @onclick="RetryMaterialDetailAsync">Retry</button>
                        <button class="btn btn-secondary" @onclick="CloseMaterialDetail">Back</button>
                    </div>
                }
                else if (_detail is not null)
                {
                    <div class="modal-header">
                        <h3 id="material-detail-title" dir="auto">@_detail.Title</h3>
                    </div>
                    <div class="modal-body">
                        <p>
                            <span class="status-badge good">@_detail.Type</span>
                            @_detail.CourseName
                            @if (!string.IsNullOrWhiteSpace(_detail.InstructorName))
                            {
                                <text> &middot; @_detail.InstructorName</text>
                            }
                            &middot; @_detail.CreatedAt.ToString("MMM d, yyyy")
                        </p>
                        @if (string.IsNullOrWhiteSpace(_detail.Description)
                            && string.IsNullOrWhiteSpace(_detail.Content)
                            && string.IsNullOrEmpty(_detail.FileUrl)
                            && !_detail.HasUploadedFile)
                        {
                            <div class="empty-state">This material has no description or content yet.</div>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(_detail.Description))
                            {
                                <p dir="auto">@_detail.Description</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.Content))
                            {
                                <div class="material-content" dir="auto">@_detail.Content</div>
                            }
                            @if (_detail.HasUploadedFile)
                            {
                                <p class="course-meta" dir="auto">
                                    Attachment: @_detail.UploadedFileName
                                    @if (_detail.UploadedFileSizeBytes.HasValue)
                                    {
                                        <text>(@FormatSize(_detail.UploadedFileSizeBytes.Value))</text>
                                    }
                                </p>
                            }
                        }
                    </div>
                    <div class="modal-actions">
                        @if (_detail.HasUploadedFile)
                        {
                            <button class="btn btn-primary" @onclick="() => DownloadAttachmentAsync(_detail)" disabled="@_downloading">
                                <UiIcon Name="download" /> @(_downloading ? "Downloading..." : "Download attachment")
                            </button>
                        }
                        @if (!string.IsNullOrEmpty(_detail.FileUrl))
                        {
                            <a class="btn btn-secondary" href="@_detail.FileUrl" target="_blank" rel="noopener">Open link</a>
                        }
                        <button class="btn btn-secondary" @onclick="CloseMaterialDetail">Back</button>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private static readonly string[] MaterialTypes =
        { "Summary", "Lecture", "Assignment", "Exam", "Announcement" };

    private MyUniversityDto? _info;
    private List<UniversityCourseDto>? _courses;
    private List<MaterialDto>? _materials;
    private MaterialDto? _detail;
    private bool _detailOpen;
    private bool _detailLoading;
    private string? _detailError;
    private int _detailId;
    private string? _error;
    private string? _downloadError;
    private bool _downloading;
    private IJSObjectReference? _downloadModule;
    private bool _loading = true;

    private string _courseId = "";
    private string _type = "";
    private string _search = "";
    private string _departmentFilter = "";
    private string _yearFilter = "";
    private string _courseSearch = "";
    private int _page = 1;
    private const int PageSize = 10;
    private int _total;
    private int TotalPages => Math.Max(1, (_total + PageSize - 1) / PageSize);

    private List<string> Departments => _courses?
        .Select(c => c.Department)
        .Where(d => !string.IsNullOrWhiteSpace(d))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(d => d, StringComparer.OrdinalIgnoreCase)
        .ToList() ?? new();

    private List<int> Years => _courses?
        .Where(c => c.AcademicYear.HasValue)
        .Select(c => c.AcademicYear!.Value)
        .Distinct()
        .OrderBy(y => y)
        .ToList() ?? new();

    private IEnumerable<UniversityCourseDto> VisibleCourses
    {
        get
        {
            if (_courses is null) return Enumerable.Empty<UniversityCourseDto>();

            var courses = _courses.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_departmentFilter))
            {
                courses = courses.Where(c =>
                    string.Equals(c.Department, _departmentFilter, StringComparison.OrdinalIgnoreCase));
            }
            if (int.TryParse(_yearFilter, out var year))
                courses = courses.Where(c => c.AcademicYear == year);
            if (!string.IsNullOrWhiteSpace(_courseSearch))
            {
                var search = _courseSearch.Trim();
                courses = courses.Where(c =>
                    c.Code.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    c.Title.Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            // Own department/year first, then the catalog order.
            return courses
                .OrderByDescending(c => c.MatchesStudentDepartmentYear)
                .ThenBy(c => c.Code, StringComparer.OrdinalIgnoreCase);
        }
    }

    private static string StatusClass(string? status) => status?.ToLowerInvariant() switch
    {
        "passed" => "passed",
        "available" => "available",
        "inprogress" => "in-progress",
        "locked" => "locked",
        _ => ""
    };
    // Deferred first-run guard: prerender / pre-restore passes must not
    // redirect or 401-logout a signed-in user (see OnAfterRenderAsync).
    private bool _started;

    protected override async Task OnInitializedAsync()
    {
        // F5: auth restores in OnAfterRenderAsync (JS interop). Never
        // redirect to /login while it is still resolving: GetUserAsync()
        // is null until the persisted token is read.
        if (!AuthService.IsInitialized)
            await AuthService.RestoreSessionAsync();
        if (!AuthService.IsInitialized)
            return;
        await GuardAndLoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_started)
        {
            _started = true;
            if (!AuthService.IsInitialized)
                await AuthService.RestoreSessionAsync();
            if (AuthService.IsInitialized)
            {
                await GuardAndLoadAsync();
                StateHasChanged();
            }
        }
    }

    private async Task GuardAndLoadAsync()
    {
        _started = true;
        var user = await AuthService.GetUserAsync();
        if (user is null)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }
        // Graduates use the university page through the alumni
        // & career-center view instead of student materials.
        if (user.Role == "Graduate")
        {
            Nav.NavigateTo("/graduate/alumni", replace: true);
            return;
        }
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        _downloadError = null;
        try
        {
            try
            {
                _info = await Http.GetFromJsonAsync<MyUniversityDto>("/api/university/me");
            }
            catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
            {
                _info = new MyUniversityDto("", "", null, 0, 0);
                return;
            }
            _courses = await Http.GetFromJsonAsync<List<UniversityCourseDto>>("/api/university/me/courses") ?? new();
            await LoadMaterialsAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            // Genuine expiry only: loads are deferred until auth resolves.
            if (!AuthService.IsInitialized)
            {
                _error = "Could not load university data. Check your connection and try again.";
            }
            else
            {
                await AuthService.LogoutAsync();
                Nav.NavigateTo("/login?expired=1");
            }
        }
        catch
        {
            _error = "Could not load university data. Check your connection and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadMaterialsAsync()
    {
        await FetchMaterialsAsync(_page);
        // A filter change can shrink the list while the user is on a later
        // page: land on the last valid page instead of an empty one.
        if (_page > TotalPages && _total > 0)
        {
            _page = TotalPages;
            await FetchMaterialsAsync(_page);
        }
    }

    private async Task FetchMaterialsAsync(int page)
    {
        var query = $"/api/university/me/materials?page={page}&pageSize={PageSize}" +
            $"&search={Uri.EscapeDataString(_search)}&type={Uri.EscapeDataString(_type)}";
        if (int.TryParse(_courseId, out var courseId))
            query += $"&courseId={courseId}";
        var result = await Http.GetFromJsonAsync<PagedResultDto<MaterialDto>>(query);
        _materials = result?.Items.ToList() ?? new();
        _total = result?.Total ?? 0;
    }

    /// <summary>Shared error surface for both filter changes and page changes
    /// on the materials list (expiring sessions never truncate the reload).</summary>
    private async Task LoadMaterialsSafeAsync()
    {
        try
        {
            await LoadMaterialsAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            // Genuine expiry only: never log out while auth is resolving.
            if (!AuthService.IsInitialized)
            {
                _error = "Could not load materials. Check your connection and try again.";
                return;
            }
            await AuthService.LogoutAsync();
            Nav.NavigateTo("/login?expired=1");
        }
        catch
        {
            _error = "Could not load materials. Check your connection and try again.";
        }
    }

    private async Task ApplyFiltersAsync()
    {
        // Filter changes intentionally restart at page 1.
        _page = 1;
        await LoadMaterialsSafeAsync();
    }

    private async Task SearchKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplyFiltersAsync();
    }

    private async Task ChangePageAsync(int delta)
    {
        // The buttons are disabled at the ends; this guard double-checks the
        // bounds so a stale click can never land outside the pager.
        var next = _page + delta;
        if (next < 1 || next > TotalPages) return;
        _page = next;
        await LoadMaterialsSafeAsync();
    }

    private async Task OpenMaterialAsync(MaterialDto material) =>
        await LoadMaterialDetailAsync(material.Id);

    /// <summary>Opens the detail modal by fetching the full DTO through
    /// GET /api/university/me/materials/{id}: the server re-checks that the
    /// material belongs to the caller's university (foreign ids are 404).</summary>
    private async Task LoadMaterialDetailAsync(int id)
    {
        _detailId = id;
        _detailOpen = true;
        _detailLoading = true;
        _detailError = null;
        _downloadError = null;
        _detail = null;
        await Task.Yield(); // let the modal paint its loading state first
        try
        {
            var dto = await Http.GetFromJsonAsync<MaterialDto>($"/api/university/me/materials/{id}");
            if (dto is null)
                _detailError = "Material not found.";
            else
                _detail = dto;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _detailError = "This material is not in your university's materials.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            // Session expiry follows the list behavior.
            if (!AuthService.IsInitialized)
            {
                _detailError = "Could not load material. Check your connection and try again.";
            }
            else
            {
                await AuthService.LogoutAsync();
                Nav.NavigateTo("/login?expired=1");
            }
        }
        catch
        {
            _detailError = "Could not load material. Check your connection and try again.";
        }
        finally
        {
            _detailLoading = false;
        }
    }

    private async Task DownloadAttachmentAsync(MaterialDto material)
    {
        if (_downloading || !material.HasUploadedFile) return;

        _downloading = true;
        _downloadError = null;
        try
        {
            using var response = await Http.GetAsync($"/api/materials/{material.Id}/file");
            if (!response.IsSuccessStatusCode)
            {
                if (response.StatusCode == HttpStatusCode.Unauthorized)
                {
                    await AuthService.LogoutAsync();
                    Nav.NavigateTo("/login?expired=1");
                    return;
                }
                if (response.StatusCode == HttpStatusCode.NotFound)
                {
                    _downloadError = "The attachment is no longer available.";
                    return;
                }

                _downloadError = $"Could not download the attachment ({(int)response.StatusCode}).";
                return;
            }

            var contentType = response.Content.Headers.ContentType?.MediaType
                ?? "application/octet-stream";
            _downloadModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/download.js");
            await using var stream = await response.Content.ReadAsStreamAsync();
            using var streamReference = new DotNetStreamReference(stream);
            await _downloadModule.InvokeVoidAsync(
                "downloadFile",
                SafeFileName(material.UploadedFileName, material.Id),
                contentType,
                streamReference);
        }
        catch
        {
            _downloadError = "Could not download the attachment. Please try again.";
        }
        finally
        {
            _downloading = false;
        }
    }

    private static string SafeFileName(string? original, int id)
    {
        if (string.IsNullOrWhiteSpace(original))
            return $"material-{id}";

        var invalid = Path.GetInvalidFileNameChars();
        var cleaned = new string(original
            .Where(c => !invalid.Contains(c) && c != '\r' && c != '\n')
            .ToArray())
            .Trim();

        if (cleaned.Length > 180)
        {
            var extension = Path.GetExtension(cleaned);
            var stem = Path.GetFileNameWithoutExtension(cleaned);
            var maxStem = Math.Max(1, 180 - extension.Length);
            cleaned = stem[..Math.Min(stem.Length, maxStem)] + extension;
        }

        return string.IsNullOrWhiteSpace(cleaned) ? $"material-{id}" : cleaned;
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024L * 1024L => $"{bytes / (1024.0 * 1024.0):0.#} MB",
        >= 1024L => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes} B"
    };

    private async Task RetryMaterialDetailAsync()
    {
        if (_detailId > 0) await LoadMaterialDetailAsync(_detailId);
    }

    private void CloseMaterialDetail()
    {
        _detailOpen = false;
        _detail = null;
        _detailId = 0;
        _downloadError = null;
    }

    private void OnDetailKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseMaterialDetail();
    }
}
