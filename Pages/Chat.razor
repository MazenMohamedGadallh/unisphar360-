@page "/chat"
@implements IAsyncDisposable
@using System.Net
@using UniSphere.Api.Dtos
@using UniSphere.Api.Services
@inject HttpClient Http
@inject NavigationManager Nav
@inject BlazorAuthService AuthService
@inject IJSRuntime JS

<PageTitle>AI Assistant - UniSphere 360+</PageTitle>

<div class="page-header">
    <h1>AI Assistant</h1>
    <p>Chat with UniSphere Assistant about your courses and studies</p>
</div>

<div class="chat-root">
    <ChatPanel ElementId="chat-messages"
               Title="UniSphere AI Assistant"
               ContextNote="Grounded in your course materials" />
</div>

@code {
    public async ValueTask DisposeAsync()
    {
        // Dispose handled by ChatPanel
    }
}
