@page "/chat"
@attribute [Authorize(Roles = "Student,Doctor,Graduate")]
@*
[Authorize] removed on purpose (see Dashboard.razor): the server
challenges every F5 to /login because the browser never sends the
localStorage JWT as a bearer header. /api stays [Authorize]-guarded
and MainLayout bounces anonymous users to /login after auth resolves.
*@
@implements IAsyncDisposable
@using System.Net
@using UniSphere.Api.Dtos
@using UniSphere.Api.Services
@inject HttpClient Http
@inject NavigationManager Nav
@inject BlazorAuthService AuthService
@inject IJSRuntime JS

<PageTitle>AI Assistant - UniSphere 360+</PageTitle>

<div class="page-header">
    <h1>AI Assistant</h1>
    <p>Chat with UniSphere Assistant about your courses and studies</p>
</div>

<div class="chat-root">
    <ChatPanel ElementId="chat-messages" />
</div>

@code {
    public async ValueTask DisposeAsync()
    {
        // Dispose handled by ChatPanel
    }
}
