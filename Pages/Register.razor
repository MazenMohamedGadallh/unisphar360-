@page "/register"
@attribute [AllowAnonymous]
@layout EmptyLayout
@rendermode @(RenderMode.InteractiveServer)
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using UniSphere.Api.Services
@inject BlazorAuthService AuthService
@inject NavigationManager Nav
@inject HttpClient Http

<PageTitle>Register - UniSphere 360+</PageTitle>

<div class="login-container">
    <div class="login-card register-card">
        <div class="login-header">
            <h1>Create your account</h1>
            <p>Join UniSphere 360+ in a minute</p>
        </div>

        @if (!string.IsNullOrEmpty(_serverError))
        {
            <div class="alert alert-error">@_serverError</div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            <h3 class="form-section-title">I am a</h3>
            <div class="role-selector">
                @foreach (var role in Roles)
                {
                    <button type="button"
                            class="@("role-option" + (_model.Role == role ? " selected" : ""))"
                            @onclick="() => _model.Role = role">
                        @role
                    </button>
                }
            </div>

            <div class="form-group">
                <label for="university">University</label>
                <InputSelect id="university" @bind-Value="_model.UniversityId">
                    <option value="">Select university...</option>
                    @if (_universities is not null)
                    {
                        @foreach (var uni in _universities)
                        {
                            <option value="@uni.Id">@uni.Name</option>
                        }
                    }
                </InputSelect>
                @if (ServerError("UniversityId") is string uniErr)
                {
                    <div class="validation-message">@uniErr</div>
                }
            </div>

            <h3 class="form-section-title">Personal info</h3>
            <div class="form-row">
                <div class="form-group">
                    <label for="firstName">First name</label>
                    <InputText id="firstName" @bind-Value="_model.FirstName" placeholder="Mazen" />
                    <ValidationMessage For="@(() => _model.FirstName)" />
                    @if (ServerError("FirstName") is string firstNameErr)
                    {
                        <div class="validation-message">@firstNameErr</div>
                    }
                </div>
                <div class="form-group">
                    <label for="lastName">Last name</label>
                    <InputText id="lastName" @bind-Value="_model.LastName" placeholder="Mohamed" />
                    <ValidationMessage For="@(() => _model.LastName)" />
                    @if (ServerError("LastName") is string lastNameErr)
                    {
                        <div class="validation-message">@lastNameErr</div>
                    }
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="middleName">Middle name (optional)</label>
                    <InputText id="middleName" @bind-Value="_model.MiddleName" placeholder="Optional" />
                    <ValidationMessage For="@(() => _model.MiddleName)" />
                </div>
                <div class="form-group">
                    <label for="age">Age</label>
                    <InputNumber id="age" @bind-Value="_model.Age" placeholder="@MinAgeForRole" min="@MinAgeForRole" max="100" />
                    <small class="field-hint">Must be at least @MinAgeForRole for a @_model.Role.</small>
                    <ValidationMessage For="@(() => _model.Age)" />
                    @if (ServerError("Age") is string ageErr)
                    {
                        <div class="validation-message">@ageErr</div>
                    }
                </div>
            </div>
            <div class="form-group">
                <label for="gender">Gender</label>
                <InputSelect id="gender" @bind-Value="_model.Gender">
                    <option value="">Select gender...</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </InputSelect>
                <ValidationMessage For="@(() => _model.Gender)" />
                @if (ServerError("Gender") is string genderErr)
                {
                    <div class="validation-message">@genderErr</div>
                }
            </div>

            @if (_model.Role == "Student")
            {
                <h3 class="form-section-title">Student details</h3>
                <div class="form-row">
                    <div class="form-group">
                        <label for="academicYear">Academic year</label>
                        <InputSelect id="academicYear" @bind-Value="_model.AcademicYear">
                            <option value="">Select year...</option>
                            @for (var year = 1; year <= 5; year++)
                            {
                                <option value="@year">Year @year</option>
                            }
                        </InputSelect>
                        @if (ServerError("AcademicYear") is string yearErr)
                        {
                            <div class="validation-message">@yearErr</div>
                        }
                    </div>
                    <div class="form-group">
                        <label for="department">Department</label>
                        <InputSelect id="department" @bind-Value="_model.Department">
                            <option value="">Select department...</option>
                            @foreach (var dept in Departments)
                            {
                                <option value="@dept">@dept</option>
                            }
                        </InputSelect>
                        @if (ServerError("Department") is string deptErr)
                        {
                            <div class="validation-message">@deptErr</div>
                        }
                    </div>
                </div>
            }
            else if (_model.Role == "Doctor")
            {
                <h3 class="form-section-title">Doctor details</h3>
                <div class="form-row">
                    <div class="form-group">
                        <label for="specialization">Specialization / department you teach</label>
                        <InputText id="specialization" @bind-Value="_model.Specialization" placeholder="e.g. Artificial Intelligence" />
                        @if (ServerError("Specialization") is string specErr)
                        {
                            <div class="validation-message">@specErr</div>
                        }
                    </div>
                    <div class="form-group">
                        <label for="doctorDepartment">Department (optional)</label>
                        <InputSelect id="doctorDepartment" @bind-Value="_model.Department">
                            <option value="">Select department...</option>
                            @foreach (var dept in Departments)
                            {
                                <option value="@dept">@dept</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            }
            else if (_model.Role == "Graduate")
            {
                <h3 class="form-section-title">Graduate details</h3>
                <div class="form-group">
                    <label for="graduatedFrom">Graduated from (university / faculty)</label>
                    <InputText id="graduatedFrom" @bind-Value="_model.GraduatedFrom" placeholder="e.g. Cairo University, Faculty of Engineering" />
                    @if (ServerError("GraduatedFrom") is string gradFromErr)
                    {
                        <div class="validation-message">@gradFromErr</div>
                    }
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="graduationYear">Graduation year</label>
                        <InputNumber id="graduationYear" @bind-Value="_model.GraduationYear" placeholder="2023" />
                        @if (ServerError("GraduationYear") is string gradYearErr)
                        {
                            <div class="validation-message">@gradYearErr</div>
                        }
                    </div>
                    <div class="form-group">
                        <label for="gradDepartment">Department</label>
                        <InputSelect id="gradDepartment" @bind-Value="_model.Department">
                            <option value="">Select department...</option>
                            @foreach (var dept in Departments)
                            {
                                <option value="@dept">@dept</option>
                            }
                        </InputSelect>
                        @if (ServerError("Department") is string gradDeptErr)
                        {
                            <div class="validation-message">@gradDeptErr</div>
                        }
                    </div>
                </div>
            }

            <h3 class="form-section-title">Contact</h3>
            <div class="form-row">
                <div class="form-group">
                    <label for="phone">Phone number</label>
                    <InputText id="phone" @bind-Value="_model.PhoneNumber" placeholder="01012345678" />
                    <ValidationMessage For="@(() => _model.PhoneNumber)" />
                    @if (ServerError("PhoneNumber") is string phoneErr)
                    {
                        <div class="validation-message">@phoneErr</div>
                    }
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <InputText id="email" type="email" @bind-Value="_model.Email" placeholder="you@unisphere.edu" />
                    <ValidationMessage For="@(() => _model.Email)" />
                    @if (ServerError("Email") is string emailErr)
                    {
                        <div class="validation-message">@emailErr</div>
                    }
                </div>
            </div>
            <div class="form-group">
                <label for="address">Address (optional)</label>
                <InputText id="address" @bind-Value="_model.Address" placeholder="7 El Shorouk St., Cairo" />
                <ValidationMessage For="@(() => _model.Address)" />
                @if (ServerError("Address") is string addressErr)
                {
                    <div class="validation-message">@addressErr</div>
                }
            </div>

            <h3 class="form-section-title">Account</h3>
            <div class="form-row">
                <div class="form-group">
                    <label for="password">Password</label>
                    <InputText id="password" type="password" @bind-Value="_model.Password" placeholder="Min 8 chars, upper + lower + digit + symbol" />
                    <ValidationMessage For="@(() => _model.Password)" />
                    @if (ServerError("Password") is string passwordErr)
                    {
                        <div class="validation-message">@passwordErr</div>
                    }
                </div>
                <div class="form-group">
                    <label for="confirmPassword">Confirm password</label>
                    <InputText id="confirmPassword" type="password" @bind-Value="_model.ConfirmPassword" placeholder="Repeat your password" />
                    <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary" disabled="@_loading">
                @(_loading ? "Creating account..." : "Register")
            </button>
        </EditForm>

        <div class="auth-switch">
            <span>Already have an account? <NavLink href="/login">Sign in</NavLink></span>
        </div>
    </div>
</div>

@code {
    private static readonly string[] Roles = { "Student", "Doctor", "Graduate" };

    // Single place to edit the department list.
    private static readonly string[] Departments =
    {
        "Computer Science", "Information Systems", "Artificial Intelligence",
        "Engineering", "Business", "Medicine", "Other"
    };

    private readonly RegisterForm _model = new();
    private List<UniversityDto>? _universities;
    private bool _loading;
    private string? _serverError;
    private Dictionary<string, string[]>? _serverFields;

    private string? ServerError(string field) =>
        _serverFields is not null && _serverFields.TryGetValue(field, out var messages)
            ? string.Join(" ", messages)
            : null;

    protected override async Task OnInitializedAsync()
    {
        // Already signed in (typed URL / Back / link): don't show the form.
        if (await AuthService.GetUserAsync() is not null)
            Nav.NavigateTo("/dashboard", replace: true);

        try
        {
            _universities = await Http.GetFromJsonAsync<List<UniversityDto>>("/api/auth/universities") ?? new();
            if (_universities.Count > 0)
                _model.UniversityId = _universities[0].Id;
        }
        catch
        {
            _universities = new();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Full reload (F5): the scoped auth service starts empty, so the
        // persisted token can only be read once JS interop is available
        // (OnAfterRenderAsync — never during prerender). Restore it here:
        // a signed-in user should land on the dashboard, not the form.
        if (firstRender && await AuthService.RestoreSessionAsync())
            Nav.NavigateTo("/dashboard", replace: true);
    }

    private int MinAgeForRole =>
        Enum.TryParse<UserType>(_model.Role, ignoreCase: true, out var type)
            ? RegistrationRules.GetMinAge(type)
            : RegistrationRules.GetMinAge(UserType.Student);

    private async Task HandleRegister()
    {
        _loading = true;
        _serverError = null;
        _serverFields = null;

        try
        {
            var result = await AuthService.RegisterAsync(new RegisterPayload(
                _model.FirstName.Trim(), string.IsNullOrWhiteSpace(_model.MiddleName) ? null : _model.MiddleName.Trim(),
                _model.LastName.Trim(), _model.PhoneNumber.Trim(), _model.Email.Trim(), _model.Gender,
                _model.Age ?? 0, _model.Role, _model.Password, _model.ConfirmPassword,
                _model.AcademicYear, string.IsNullOrWhiteSpace(_model.Department) ? null : _model.Department,
                string.IsNullOrWhiteSpace(_model.Specialization) ? null : _model.Specialization.Trim(),
                string.IsNullOrWhiteSpace(_model.GraduatedFrom) ? null : _model.GraduatedFrom.Trim(),
                _model.GraduationYear,
                _model.UniversityId,
                string.IsNullOrWhiteSpace(_model.Address) ? null : _model.Address.Trim()));

            if (result.Succeeded)
            {
                // The API returns a token, so the user is logged in right away.
                Nav.NavigateTo("/dashboard");
                return;
            }

            _serverFields = result.FieldErrors;
            _serverError = result.ErrorMessage;
        }
        catch
        {
            _serverError = "Registration failed. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    public class RegisterForm : IValidatableObject
    {
        private const string EgyptianPhone = @"^(\+20|0)?1[0125]\d{8}$";
        private const string InternationalPhone = @"^\+?[1-9]\d{7,14}$";
        private const string PasswordPattern = @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).{8,}$";

        [Required(ErrorMessage = "First name is required.")]
        [StringLength(100, ErrorMessage = "First name is too long.")]
        public string FirstName { get; set; } = "";

        [StringLength(100, ErrorMessage = "Middle name is too long.")]
        public string? MiddleName { get; set; }

        [Required(ErrorMessage = "Last name is required.")]
        [StringLength(100, ErrorMessage = "Last name is too long.")]
        public string LastName { get; set; } = "";

        [Required(ErrorMessage = "Phone number is required.")]
        public string PhoneNumber { get; set; } = "";

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Gender is required.")]
        public string Gender { get; set; } = "";

        [StringLength(200, ErrorMessage = "Address is too long.")]
        public string? Address { get; set; }

        [Required(ErrorMessage = "Age is required.")]
        public int? Age { get; set; }

        [Required]
        public string Role { get; set; } = "Student";

        [Required(ErrorMessage = "Password is required.")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters.")]
        [RegularExpression(PasswordPattern, ErrorMessage = "Password must include an upper-case letter, a lower-case letter, a digit and a symbol.")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Please confirm your password.")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";

        public int? AcademicYear { get; set; }
        public int? UniversityId { get; set; }
        public string? Department { get; set; } = "";
        public string? Specialization { get; set; } = "";
        public string? GraduatedFrom { get; set; } = "";
        public int? GraduationYear { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!Regex.IsMatch(PhoneNumber.Trim(), EgyptianPhone)
                && !Regex.IsMatch(PhoneNumber.Trim(), InternationalPhone))
                yield return new ValidationResult(
                    "Enter a valid phone number (e.g. 01012345678 or +201012345678).",
                    new[] { nameof(PhoneNumber) });

            if (Age.HasValue
                && Enum.TryParse<UserType>(Role, ignoreCase: true, out var userType)
                && (Age.Value < RegistrationRules.GetMinAge(userType) || Age.Value > RegistrationRules.MaxAge))
                yield return new ValidationResult(
                    $"{RegistrationRules.MinAgeMessage(userType)} Maximum age is {RegistrationRules.MaxAge}.",
                    new[] { nameof(Age) });

            if (Role == "Student")
            {
                if (AcademicYear is null or < 1 or > 5)
                    yield return new ValidationResult(
                        "Academic year is required (1-5).", new[] { nameof(AcademicYear) });
                if (string.IsNullOrWhiteSpace(Department))
                    yield return new ValidationResult(
                        "Department is required.", new[] { nameof(Department) });
            }
            else if (Role == "Doctor")
            {
                if (string.IsNullOrWhiteSpace(Specialization))
                    yield return new ValidationResult(
                        "Specialization is required.", new[] { nameof(Specialization) });
            }
            else if (Role == "Graduate")
            {
                if (string.IsNullOrWhiteSpace(GraduatedFrom))
                    yield return new ValidationResult(
                        "Graduated from is required.", new[] { nameof(GraduatedFrom) });
                if (GraduationYear is null || GraduationYear < 1950 || GraduationYear > DateTime.UtcNow.Year)
                    yield return new ValidationResult(
                        $"Graduation year must be between 1950 and {DateTime.UtcNow.Year}.",
                        new[] { nameof(GraduationYear) });
                if (string.IsNullOrWhiteSpace(Department))
                    yield return new ValidationResult(
                        "Department is required.", new[] { nameof(Department) });
            }
        }
    }
}
