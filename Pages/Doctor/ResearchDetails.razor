@page "/doctor/research/{Id:int}"
@attribute [Authorize(Roles = "Doctor")]
@using System.Net
@using System.Text.Json
@using Microsoft.JSInterop
@using UniSphere.Api.Dtos
@using UniSphere.Api.Services
@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Nav
@inject BlazorAuthService AuthService
@inject IJSRuntime JS

<PageTitle>Research details - UniSphere 360+</PageTitle>

<RoleGate Roles="Doctor">
    <div class="page-header">
        <a class="back-link" href="/doctor/research?tab=browse"><UiIcon Name="arrow-left" /> Back to Research Hub</a>
        <h1>Research details</h1>
        <p>Published work from a doctor at any university.</p>
    </div>

    @if (!string.IsNullOrEmpty(_toast))
    {
        <div class="alert @(_toastIsError ? "alert-error" : "alert-success")">@_toast</div>
    }

    @if (_loading)
    {
        <div class="loading">Loading the paper...</div>
    }
    else if (_notFound)
    {
        <div class="card">
            <div class="empty-state">
                <h3>Paper not found</h3>
                <p>This paper may be a draft, or it may have been removed.</p>
                <NavLink class="btn btn-secondary" href="/doctor/research?tab=browse">Back to Browse Research</NavLink>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-error">@_error <button type="button" class="btn btn-sm btn-secondary" @onclick="LoadAsync">Retry</button></div>
    }
    else if (_detail is not null)
    {
        <article class="card research-detail">
            <div class="research-detail-head">
                <div>
                    <h2>@_detail.Title</h2>
                    <p class="research-detail-authors">@_detail.Authors</p>
                </div>
                @if (_detail.HasPdf)
                {
                    <button type="button" class="btn btn-primary" @onclick="DownloadPdfAsync" disabled="@_downloading">
                        @(_downloading ? "Preparing..." : "Download PDF")
                    </button>
                }
            </div>

            <div class="research-meta research-detail-meta">
                <span>@_detail.Year</span>
                <span>@_detail.Field</span>
                <span>Published @_detail.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</span>
            </div>

            <div class="research-author-line research-detail-author">
                <span class="research-avatar" aria-hidden="true"><UiIcon Name="user-round" /></span>
                <span>
                    <strong>@_detail.AuthorName</strong>
                    <span class="research-author-sub">
                        @(string.IsNullOrWhiteSpace(_detail.AuthorDepartment) ? "Department not set" : _detail.AuthorDepartment)
                        @if (!string.IsNullOrWhiteSpace(_detail.UniversityName))
                        {
                            <span> &middot; @_detail.UniversityName</span>
                        }
                    </span>
                </span>
            </div>

            <section class="research-detail-section">
                <h3>Abstract</h3>
                <p class="research-full-abstract">@_detail.Abstract</p>
            </section>

            @if (!string.IsNullOrWhiteSpace(_detail.Keywords))
            {
                <section class="research-detail-section">
                    <h3>Keywords</h3>
                    <p class="research-keywords">@_detail.Keywords</p>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(_detail.DoiOrUrl) && DoiHref is not null)
            {
                <section class="research-detail-section">
                    <h3>DOI / link</h3>
                    <a href="@DoiHref" target="_blank" rel="noopener noreferrer">@_detail.DoiOrUrl</a>
                </section>
            }
        </article>
    }
</RoleGate>

@code {
    [Parameter] public int Id { get; set; }

    private ResearchDetailDto? _detail;
    private bool _loading = true;
    private bool _notFound;
    private string? _error;
    private string? _toast;
    private bool _toastIsError;
    private bool _downloading;
    private bool _started;
    private int _loadedId;
    private IJSObjectReference? _downloadModule;

    private string? DoiHref
    {
        get
        {
            var value = _detail?.DoiOrUrl;
            if (string.IsNullOrWhiteSpace(value)) return null;
            if (value.StartsWith("10.", StringComparison.Ordinal))
                return $"https://doi.org/{value}";
            return Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
                   (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
                ? value
                : null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsInitialized)
            await AuthService.RestoreSessionAsync();
        if (AuthService.IsInitialized)
            await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_started)
        {
            _started = true;
            if (!AuthService.IsInitialized)
                await AuthService.RestoreSessionAsync();
            if (AuthService.IsInitialized && _loadedId != Id)
            {
                await LoadAsync();
                StateHasChanged();
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Navigating from one detail page to another reuses the component.
        if (_started && AuthService.IsInitialized && _loadedId != Id)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _notFound = false;
        _detail = null;
        try
        {
            var response = await Http.GetAsync($"/api/doctor/research/browse/{Id}");
            if (response.IsSuccessStatusCode)
            {
                _detail = await response.Content.ReadFromJsonAsync<ResearchDetailDto>();
                if (_detail is null) _notFound = true;
                _loadedId = Id;
            }
            else if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _notFound = true;
                _loadedId = Id;
            }
            else if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                await AuthService.LogoutAsync();
                Nav.NavigateTo("/login?expired=1");
            }
            else if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _error = "You do not have permission to view this paper.";
            }
            else
            {
                _error = await ErrorTextAsync(response);
            }
        }
        catch
        {
            _error = "Could not load the paper. Check your connection and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DownloadPdfAsync()
    {
        if (_downloading || _detail is null) return;
        _downloading = true;
        _toast = null;
        try
        {
            using var response = await Http.GetAsync($"/api/doctor/research/{Id}/pdf");
            if (!response.IsSuccessStatusCode)
            {
                if (response.StatusCode == HttpStatusCode.Unauthorized)
                {
                    await AuthService.LogoutAsync();
                    Nav.NavigateTo("/login?expired=1");
                }
                else if (response.StatusCode == HttpStatusCode.NotFound)
                {
                    Toast("The PDF is no longer available.", true);
                }
                else
                {
                    Toast(await ErrorTextAsync(response), true);
                }
                return;
            }

            _downloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
            await using var stream = await response.Content.ReadAsStreamAsync();
            using var streamReference = new DotNetStreamReference(stream);
            await _downloadModule.InvokeVoidAsync("downloadPdf", SafeFileName(_detail.Title, Id), streamReference);
        }
        catch
        {
            Toast("Could not download the PDF. Please try again.", true);
        }
        finally
        {
            _downloading = false;
        }
    }

    private static string SafeFileName(string title, int id)
    {
        var invalid = Path.GetInvalidFileNameChars();
        var cleaned = new string(title.Where(c => !invalid.Contains(c) && c != '\r' && c != '\n').ToArray()).Trim();
        if (cleaned.Length > 80) cleaned = cleaned[..80];
        if (string.IsNullOrWhiteSpace(cleaned)) cleaned = $"research-{id}";
        return $"{cleaned}.pdf";
    }

    private void Toast(string message, bool isError = false)
    {
        _toast = message;
        _toastIsError = isError;
    }

    private static async Task<string> ErrorTextAsync(HttpResponseMessage response)
    {
        var text = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(text))
            return $"Request failed ({(int)response.StatusCode}).";

        try
        {
            using var doc = JsonDocument.Parse(text);
            if (doc.RootElement.TryGetProperty("errors", out var errors) &&
                errors.ValueKind == JsonValueKind.Object)
            {
                var messages = new List<string>();
                foreach (var property in errors.EnumerateObject())
                {
                    foreach (var item in property.Value.EnumerateArray())
                    {
                        var message = item.GetString();
                        if (!string.IsNullOrWhiteSpace(message) && !messages.Contains(message))
                            messages.Add(message);
                    }
                }
                if (messages.Count > 0)
                    return string.Join(" ", messages);
            }

            foreach (var key in new[] { "message", "detail", "title" })
            {
                if (doc.RootElement.TryGetProperty(key, out var value) &&
                    value.ValueKind == JsonValueKind.String &&
                    !string.IsNullOrWhiteSpace(value.GetString()))
                    return value.GetString()!;
            }
        }
        catch
        {
            // Not JSON: fall through to the raw text.
        }

        return text.Trim('"');
    }

    public async ValueTask DisposeAsync()
    {
        if (_downloadModule is not null)
        {
            try { await _downloadModule.DisposeAsync(); }
            catch { /* circuit is closing */ }
        }
    }
}
