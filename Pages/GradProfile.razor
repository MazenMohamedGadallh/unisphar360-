@page "/graduate/profile"
@inherits UniSphere.Api.Components.GradPageBase
@using System.Net
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>My Career Profile - UniSphere 360+</PageTitle>

<div class="page-header">
    <h1>My Career Profile</h1>
    <p>Keep your profile current — employers and AI tools use it</p>
</div>

@if (_error is not null)
{
    <div class="alert alert-error">@_error <button class="btn btn-small" @onclick="LoadAsync">Retry</button></div>
}
else if (_loading)
{
    <div class="loading">Loading profile...</div>
}
else if (_profile is not null)
{
    <div class="grad-overview-hero">
        <div class="hero-text">
            <h2>@_profile.FullName</h2>
            <p>@(_profile.Headline ?? "No headline yet") &middot; completion @_profile.CompletionPercent%</p>
        </div>
    </div>

    <div class="grad-two-col">
        <div class="card">
            <div class="card-header"><h3><Icon Name="user-round" Size="16" /> Profile fields</h3></div>
            <form @onsubmit="SaveAsync" class="profile-form">
                <div class="form-group">
                    <label for="grHeadline">Professional headline</label>
                    <input id="grHeadline" @bind="_editHeadline" placeholder="Backend Developer | .NET & APIs" />
                </div>
                <div class="form-group">
                    <label for="grSummary">Career summary</label>
                    <textarea id="grSummary" rows="3" @bind="_editSummary"></textarea>
                </div>
                <div class="form-inline">
                    <div class="form-group">
                        <label for="grLinkedIn">LinkedIn URL</label>
                        <input id="grLinkedIn" @bind="_editLinkedIn" placeholder="https://linkedin.com/in/..." />
                    </div>
                    <div class="form-group">
                        <label for="grGitHub">GitHub URL</label>
                        <input id="grGitHub" @bind="_editGitHub" placeholder="https://github.com/..." />
                    </div>
                </div>
                <div class="form-inline">
                    <div class="form-group">
                        <label for="grPortfolio">Portfolio URL</label>
                        <input id="grPortfolio" @bind="_editPortfolio" placeholder="https://..." />
                    </div>
                    <div class="form-group">
                        <label for="grTitles">Target job titles</label>
                        <input id="grTitles" @bind="_editTitles" placeholder="Backend Developer, Data Analyst" />
                    </div>
                </div>
                <div class="form-inline">
                    <div class="form-group">
                        <label for="grIndustries">Preferred industries</label>
                        <input id="grIndustries" @bind="_editIndustries" placeholder="Tech, Fintech" />
                    </div>
                    <div class="form-group">
                        <label for="grLocations">Preferred locations</label>
                        <input id="grLocations" @bind="_editLocations" placeholder="Cairo, Egypt, Remote" />
                    </div>
                </div>
                <div class="form-inline">
                    <div class="form-group">
                        <label for="grWorkModes">Work modes</label>
                        <input id="grWorkModes" @bind="_editWorkModes" placeholder="Remote, Hybrid, Onsite" />
                    </div>
                    <div class="form-group">
                        <label for="grEmployment">Employment type</label>
                        <input id="grEmployment" @bind="_editEmployment" placeholder="Full-time" />
                    </div>
                </div>
                <div class="form-inline">
                    <div class="form-group">
                        <label for="grLevel">Experience level</label>
                        <input id="grLevel" @bind="_editExperience" placeholder="Entry-level" />
                    </div>
                    <div class="form-group">
                        <label for="grLanguages">Languages</label>
                        <input id="grLanguages" @bind="_editLanguages" placeholder="Arabic (Native), English (Fluent)" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="grGoal">Career goal</label>
                    <textarea id="grGoal" rows="2" @bind="_editGoal"></textarea>
                </div>
                <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Saving..." : "Save profile")</button>
                @if (_savedMessage is not null)
                {
                    <em class="muted"> @_savedMessage</em>
                }
            </form>
        </div>

        <div>
            <div class="card" style="margin-bottom:14px;">
                <div class="card-header">
                    <h3><Icon Name="graduation-cap" Size="16" /> Education &amp; account</h3>
                </div>
                <div class="grad-list">
                    <div class="prof-row"><span class="prof-label">Field of study</span><span>@(Show(_profile.Major))</span></div>
                    <div class="prof-row"><span class="prof-label">Department</span><span>@(Show(_profile.Department))</span></div>
                    <div class="prof-row"><span class="prof-label">University</span><span>@(Show(_profile.UniversityName))</span></div>
                    <div class="prof-row"><span class="prof-label">Graduated from</span><span>@(Show(_profile.GraduatedFrom))</span></div>
                    <div class="prof-row"><span class="prof-label">Graduation year</span><span>@(_profile.GraduationYear?.ToString() ?? "—")</span></div>
                </div>
                <p class="muted" style="margin:8px 0 0;">Academic details are managed by the university. Contact support to correct them.</p>
            </div>

            <div class="card" style="margin-bottom:14px;">
                <div class="card-header">
                    <h3><Icon Name="target" Size="16" /> Profile completion</h3>
                    <span class="grad-badge">@_profile.CompletionPercent%</span>
                </div>
                <div class="completion-bar" aria-label="@("Profile completion: " + _profile.CompletionPercent + "%")">
                    <span style="width:@_profile.CompletionPercent%;"></span>
                </div>
                @if (_profile.MissingFields.Count == 0)
                {
                    <p class="muted" style="margin:10px 0 0;">Everything is filled in — well done.</p>
                }
                else
                {
                    <p class="muted" style="margin:10px 0 6px;">Still missing:</p>
                    <div class="missing-chips">
                        @foreach (var missing in _profile.MissingFields)
                        {
                            <span class="missing-chip">@missing</span>
                        }
                    </div>
                }
            </div>

            <div class="card" style="margin-bottom:14px;">
                <div class="card-header">
                    <h3><Icon Name="file-text" Size="16" /> CV &amp; Resume</h3>
                    <a class="btn btn-small" href="/graduate/cv">Open CV Studio</a>
                </div>
                @if (_latestCv is null)
                {
                    <p class="muted" style="margin:4px 0 10px;">
                        No CV on file yet. Upload one so AI matching, interview prep, and skill-gap analysis
                        have real material to work with.
                    </p>
                }
                else
                {
                    <div class="cv-latest">
                        <Icon Name="file-text" Size="18" />
                        <div class="cv-meta">
                            <div class="cv-mname"><strong>@TruncateName(_latestCv.FileName)</strong> <span class="muted">&middot; @(_latestCv.SizeBytes / 1024) KB</span></div>
                            <div class="muted">
                                Uploaded @FormatUtc(_latestCv.UploadedAtUtc) &middot; @_latestCv.ParseStatus
                                @if (_latestCv.HasAnalysis)
                                {
                                    <span class="grad-badge">AI analysis ready</span>
                                }
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_latestCv.ParseError))
                    {
                        <p class="muted" style="margin:8px 0 0;">Extraction note: @_latestCv.ParseError. You can enter manual text in CV Studio.</p>
                    }
                }
                <label class="app-file-upload" style="margin-top:10px;">
                    <InputFile OnChange="@(e => UploadCvAsync(e.File))" accept=".pdf,.doc,.docx" />
                    <span class="btn btn-primary btn-small">@(_uploadingCv ? "Uploading…" : "Upload CV (PDF or DOCX)")</span>
                </label>
            </div>

            <div class="card">
                <div class="card-header"><h3><Icon Name="star" Size="16" /> Skills (@_profile.Skills.Count)</h3></div>
                @if (_profile.Skills.Count == 0)
                {
                    <div class="empty-state">No skills added yet.</div>
                }
                else
                {
                    <ul class="grad-list">
                        @foreach (var skill in _profile.Skills)
                        {
                            <li>
                                <strong>@skill.Name</strong> <span class="muted">@(skill.Level ?? "no level set")</span>
                                <span class="grad-badge">@skill.Source</span>
                                <button class="btn btn-small btn-danger" @onclick="() => RemoveSkillAsync(skill.Id)">Remove</button>
                            </li>
                        }
                    </ul>
                }
                <div class="form-inline" style="margin-top:10px;">
                    <div class="form-group">
                        <label for="grSkillName">New skill</label>
                        <input id="grSkillName" @bind-value="_skillName" @bind-value:event="oninput" placeholder="C#" />
                    </div>
                    <div class="form-group">
                        <label for="grSkillLevel">Level</label>
                        <input id="grSkillLevel" @bind="_skillLevel" placeholder="Intermediate" />
                    </div>
                    <button class="btn btn-primary btn-small" @onclick="AddSkillAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_skillName))">@(_busy ? "Working..." : "Add skill")</button>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h3>Experience &amp; projects</h3></div>
                @if (_profile.Entries.Count == 0)
                {
                    <div class="empty-state">No entries yet. Add your experience, projects, certifications or education.</div>
                }
                else
                {
                    <ul class="grad-list">
                        @foreach (var entry in _profile.Entries)
                        {
                            <li>
                                <span class="grad-badge">@entry.Kind</span>
                                <strong>@entry.Title</strong>
                                @if (!string.IsNullOrEmpty(entry.Organization))
                                {
                                    <span class="muted"> &middot; @entry.Organization</span>
                                }
                                @if (!string.IsNullOrEmpty(entry.Period))
                                {
                                    <span class="muted"> &middot; @entry.Period</span>
                                }
                                @if (!string.IsNullOrEmpty(entry.Description))
                                {
                                    <div class="muted">@entry.Description</div>
                                }
                                <button class="btn btn-small" @onclick="() => RemoveEntryAsync(entry.Id)">Remove</button>
                            </li>
                        }
                    </ul>
                }
                <div class="form-inline" style="margin-top:10px;">
                    <div class="form-group">
                        <label for="grEntryKind">Type</label>
                        <select id="grEntryKind" @bind="_entryKind">
                            <option>Experience</option>
                            <option>Project</option>
                            <option>Certification</option>
                            <option>Education</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="grEntryTitle">Title</label>
                        <input id="grEntryTitle" @bind-value="_entryTitle" @bind-value:event="oninput" placeholder="Backend Engineering Intern" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="grEntryOrg">Organization</label>
                    <input id="grEntryOrg" @bind="_entryOrg" placeholder="Company / university" />
                </div>
                <div class="form-group">
                    <label for="grEntryDesc">Description</label>
                    <textarea id="grEntryDesc" rows="2" @bind="_entryDesc"></textarea>
                </div>
                <div class="form-inline">
                    <div class="form-group">
                        <label for="grEntryPeriod">Period</label>
                        <input id="grEntryPeriod" @bind="_entryPeriod" placeholder="2025 - 2026" />
                    </div>
                    <button class="btn btn-primary btn-small" @onclick="AddEntryAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_entryTitle))">@(_busy ? "Working..." : "Add")</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private GradProfileModel? _profile;
    private bool _saving;
    private string? _savedMessage;
    private bool _busy;

    // CV widget
    private List<GradCvModel> _cvs = [];
    private GradCvModel? _latestCv;
    private bool _uploadingCv;

    private string _editHeadline = "";
    private string _editSummary = "";
    private string _editLinkedIn = "";
    private string _editGitHub = "";
    private string _editPortfolio = "";
    private string _editTitles = "";
    private string _editIndustries = "";
    private string _editLocations = "";
    private string _editWorkModes = "";
    private string _editEmployment = "";
    private string _editExperience = "";
    private string _editLanguages = "";
    private string _editGoal = "";

    private string _skillName = "";
    private string _skillLevel = "";
    private string _entryKind = "Experience";
    private string _entryTitle = "";
    private string _entryOrg = "";
    private string _entryDesc = "";
    private string _entryPeriod = "";

    protected override async Task OnInitializedAsync()
    {
        if (!await GuardGraduateAsync()) return;
        await LoadAsync();
    }

    private void FillFromProfile(GradProfileModel profile)
    {
        _editHeadline = profile.Headline ?? "";
        _editSummary = profile.CareerSummary ?? "";
        _editLinkedIn = profile.LinkedInUrl ?? "";
        _editGitHub = profile.GitHubUrl ?? "";
        _editPortfolio = profile.PortfolioUrl ?? "";
        _editTitles = profile.PreferredJobTitles ?? "";
        _editIndustries = profile.PreferredIndustries ?? "";
        _editLocations = profile.PreferredLocations ?? "";
        _editWorkModes = profile.WorkModes ?? "";
        _editEmployment = profile.EmploymentType ?? "";
        _editExperience = profile.ExperienceLevel ?? "";
        _editLanguages = profile.Languages ?? "";
        _editGoal = profile.CareerGoal ?? "";
    }

    private async Task LoadAsync()
    {
        _error = null;
        _loading = true;
        StateHasChanged();
        var profile = await GetJsonAsync<GradProfileModel>("/api/grad/profile");
        if (profile is not null)
        {
            _profile = profile;
            FillFromProfile(profile);
        }
        var cvs = await GetJsonAsync<List<GradCvModel>>("/api/grad/profile/cv");
        if (cvs is not null)
        {
            _cvs = cvs.OrderByDescending(c => c.UploadedAtUtc).ToList();
            _latestCv = _cvs.FirstOrDefault();
        }
        _loading = false;
        StateHasChanged();
    }

    private async Task SaveAsync(EventArgs e)
    {
        _saving = true;
        _savedMessage = null;
        StateHasChanged();
        var (value, error) = await PutJsonAsync<GradProfileModel>("/api/grad/profile", new
        {
            headline = _editHeadline, careerSummary = _editSummary,
            linkedInUrl = _editLinkedIn, gitHubUrl = _editGitHub, portfolioUrl = _editPortfolio,
            preferredJobTitles = _editTitles, preferredIndustries = _editIndustries,
            preferredLocations = _editLocations,
            workModes = _editWorkModes, employmentType = _editEmployment,
            experienceLevel = _editExperience, languages = _editLanguages, careerGoal = _editGoal
        });
        _saving = false;
        if (error is not null) _error = error;
        else if (value is not null)
        {
            _profile = value;
            _savedMessage = "Saved.";
        }
        StateHasChanged();
        await Task.Delay(2000);
        _savedMessage = null;
        StateHasChanged();
    }

    private async Task AddSkillAsync()
    {
        if (string.IsNullOrWhiteSpace(_skillName) || _busy) return;
        _busy = true;
        StateHasChanged();
        var (value, error) = await PostJsonAsync<GradSkillModel>("/api/grad/profile/skills",
            new { name = _skillName, level = string.IsNullOrWhiteSpace(_skillLevel) ? null : (object?)_skillLevel });
        _busy = false;
        if (error is not null) { _error = error; StateHasChanged(); return; }
        _skillName = "";
        _skillLevel = "";
        await LoadAsync();
    }

    private async Task RemoveSkillAsync(int id)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        StateHasChanged();
        var error = await DeleteAsync($"/api/grad/profile/skills/{id}");
        _busy = false;
        if (error is not null) { _error = error; _loading = false; StateHasChanged(); return; }
        await LoadAsync();
    }

    private async Task AddEntryAsync()
    {
        if (string.IsNullOrWhiteSpace(_entryTitle) || _busy) return;
        _busy = true;
        StateHasChanged();
        var (value, error) = await PostJsonAsync<ProfileEntryItemModel>("/api/grad/profile/entries", new
        {
            kind = _entryKind, title = _entryTitle,
            organization = _entryOrg, description = _entryDesc, period = _entryPeriod
        });
        _busy = false;
        if (error is not null) { _error = error; StateHasChanged(); return; }
        _entryTitle = "";
        _entryOrg = "";
        _entryDesc = "";
        _entryPeriod = "";
        await LoadAsync();
    }

    private async Task RemoveEntryAsync(int id)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        StateHasChanged();
        var error = await DeleteAsync($"/api/grad/profile/entries/{id}");
        _busy = false;
        if (error is not null) { _error = error; _loading = false; StateHasChanged(); return; }
        await LoadAsync();
    }

    private async Task UploadCvAsync(IBrowserFile file)
    {
        if (file.Size > 10 * 1024 * 1024)
        {
            _error = "CV file is larger than the 10 MB limit.";
            StateHasChanged();
            return;
        }
        _uploadingCv = true;
        _error = null;
        StateHasChanged();
        using var content = new MultipartFormDataContent();
        content.Headers.ContentDisposition = new ContentDispositionHeaderValue("form-data") { Name = "file" };
        await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        buffer.Position = 0;
        var fileContent = new StreamContent(buffer);
        fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
        content.Add(fileContent, "file", file.Name);
        var (value, error) = await PostMultipartAsync<GradCvModel>("/api/grad/profile/cv", content);
        _uploadingCv = false;
        if (error is not null)
        {
            _error = error;
        }
        else if (value is not null)
        {
            await LoadAsync();
        }
        else
        {
            await LoadAsync();
        }
        StateHasChanged();
    }

    private static string Show(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();

    private static string TruncateName(string name)
    {
        var shown = System.IO.Path.GetFileName(name);
        return shown.Length <= 42 ? shown : shown[..39] + "…";
    }

    private static string FormatUtc(DateTime utc) => utc.ToString("MMM dd, yyyy HH:mm 'UTC'");
}
