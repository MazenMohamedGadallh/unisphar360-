@page "/courses"
@page "/courses/{Id:int}"
@*
[Authorize] removed on purpose (see Dashboard.razor): the server
challenges every F5 to /login because the browser never sends the
localStorage JWT as a bearer header. /api stays [Authorize]-guarded
and MainLayout bounces anonymous users to /login after auth resolves.
*@
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Courses - UniSphere 360+</PageTitle>

@if (Id.HasValue)
{
    <!-- Course Detail View -->
    <div class="page-header">
        <NavLink href="/courses" class="back-link">&larr; Back to Courses</NavLink>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-error">@_error <button class="btn btn-small" @onclick="RetryAsync">Retry</button></div>
    }
    else if (_course is null)
    {
        <div class="loading">Loading course...</div>
    }
    else
    {
        <div class="card course-detail">
            <div class="card-header">
                <div>
                    <h2>@_course.Code - @_course.Title</h2>
                    <p class="course-meta">@_course.Track | @_course.Credits Credits</p>
                </div>
                <button class="btn btn-primary" @onclick="Enroll" disabled="@_enrolling">@(string.IsNullOrWhiteSpace(_enrollMessage) ? (_enrolling ? "Enrolling..." : "Enroll") : "Enroll")</button>
            </div>
            <div class="card-body">
                <h4>Description</h4>
                <p>@_course.Description</p>
                @if (!string.IsNullOrEmpty(_enrollMessage))
                {
                    <div class="alert @(_enrollError ? "alert-error" : "alert-success")" role="status">@_enrollMessage</div>
                }
            </div>
        </div>
    }
}

@if (!string.IsNullOrEmpty(_error) && !Id.HasValue)
{
    <div class="alert alert-error">@_error <button class="btn btn-small" @onclick="RetryAsync">Retry</button></div>
}

@if (Id.HasValue == false)
{
    <!-- Course List View -->
    <div class="page-header">
        <h1>Courses</h1>
        <p>Browse available courses and enroll.</p>
    </div>

    <div class="search-section">
        <div class="search-box-large">
            <span class="search-icon"><Icon Name="search" /></span>
            <input type="text" placeholder="Search courses..." @bind="_searchQuery" @bind:event="oninput" />
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Available Courses</h3>
        </div>
        @if (_courses is null)
        {
            <div class="loading">Loading courses...</div>
        }
        else if (!_courses.Any())
        {
            <div class="empty-state">No courses found.</div>
        }
        else
        {
            <div class="course-grid">
                @foreach (var course in Filtered())
                {
                    @if (string.IsNullOrWhiteSpace(_searchQuery) || Matches(course))
                    {
                        <div class="course-card" @onclick="() => NavigateToCourse(course.Id)">
                            <div class="course-card-header">
                                <span class="course-code">@course.Code</span>
                                <span class="course-track">@course.Track</span>
                            </div>
                            <h4>@course.Title</h4>
                            <p>@course.Description</p>
                            <div class="course-footer">
                                <span>@course.Credits credits</span>
                                <span class="view-link">View &rarr;</span>
                            </div>
                        </div>
                    }
                }
                @if (!Filtered().Any())
                {
                    <div class="empty-state">No course matches "@_searchQuery".</div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private List<CourseDto>? _courses;
    private CourseDto? _course;
    private string _searchQuery = "";
    private string? _error;
    private bool _enrolling;
    private string? _enrollMessage;
    private bool _enrollError;

    private bool Matches(CourseDto c) => string.IsNullOrWhiteSpace(_searchQuery)
        || c.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
        || c.Code.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
        || c.Description.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase);

    private IEnumerable<CourseDto> Filtered() =>
        string.IsNullOrWhiteSpace(_searchQuery)
            ? _courses ?? Enumerable.Empty<CourseDto>()
            : _courses!.Where(Matches);

    protected override void OnParametersSet()
    {
        // Covers first render and navigations between /courses and /courses/{id}.
        Load();
    }

    private void Load()
    {
        _error = null;
        _enrollMessage = null;
        _searchQuery = "";
        _course = null;
        _courses = null;
        if (Id.HasValue)
        {
            _ = LoadCourseAsync(Id.Value);
        }
        else
        {
            _ = LoadCoursesAsync();
        }
    }

    private async Task LoadCourseAsync(int id)
    {
        try
        {
            _course = await Http.GetFromJsonAsync<CourseDto>($"/api/courses/{id}");
        }
        catch (Exception ex)
        {
            // Unknown /courses/{id} must show a friendly state, not crash the circuit.
            _error = $"Course not found ({(ex.InnerException ?? ex).Message}).";
        }
        StateHasChanged();
    }

    private async Task LoadCoursesAsync()
    {
        try
        {
            _courses = await Http.GetFromJsonAsync<List<CourseDto>>("/api/courses");
        }
        catch (Exception ex)
        {
            _error = $"Could not load courses ({(ex.InnerException ?? ex).Message}).";
        }
        StateHasChanged();
    }

    private Task RetryAsync() { Load(); return Task.CompletedTask; }

    private void NavigateToCourse(int id) => Nav.NavigateTo($"/courses/{id}");

    private async Task Enroll()
    {
        if (_course is null || _enrolling) return;
        _enrolling = true;
        _enrollMessage = null;
        _enrollError = false;
        StateHasChanged();
        HttpResponseMessage response;
        try
        {
            response = await Http.PostAsJsonAsync("/api/enrollments", new { courseId = _course.Id });
        }
        catch (Exception ex)
        {
            _enrolling = false;
            _enrollError = true;
            _enrollMessage = $"Enrollment failed ({(ex.InnerException ?? ex).Message}).";
            StateHasChanged();
            return;
        }
        _enrolling = false;
        if (response.IsSuccessStatusCode)
        {
            Nav.NavigateTo("/enrollments");
            return;
        }
        _enrollError = true;
        var body = "";
        try { body = await response.Content.ReadAsStringAsync(); } catch { /* ignore */ }
        _enrollMessage = response.StatusCode == System.Net.HttpStatusCode.Conflict
            ? "You are already enrolled in this course."
            : $"Enrollment failed ({(body.Length > 160 ? body[..160] : body)})";
        StateHasChanged();
    }
}

public record CourseDto(int Id, string Code, string Title, string Description, string Track, int Credits);
