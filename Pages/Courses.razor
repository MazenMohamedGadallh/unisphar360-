@page "/courses"
@page "/courses/{Id:int}"
@* Second home under My Courses so the sidebar item stays highlighted. *@
@page "/university/browse"
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Courses - UniSphere 360+</PageTitle>
<RoleGate Roles="Student">

@if (Id.HasValue)
{
    <!-- Course Detail View -->
    <div class="page-header">
        <NavLink href="/university/browse" class="back-link"><UiIcon Name="arrow-left" /> Back to Courses</NavLink>
    </div>

    @if (_course is null)
    {
        <div class="loading">Loading course...</div>
    }
    else
    {
        <div class="card course-detail">
            <div class="card-header">
                <div>
                    <h2>@_course.Code - @_course.Title</h2>
                    <p class="course-meta">@_course.Track | @_course.Credits Credits</p>
                    @if (!string.IsNullOrWhiteSpace(_course.Instructors))
                    {
                        <p class="course-meta">Instructor: @_course.Instructors</p>
                    }
                </div>
                <button class="btn btn-primary" @onclick="Enroll"><UiIcon Name="plus" /> Enroll</button>
            </div>
            <div class="card-body">
                <h4>Description</h4>
                <p>@_course.Description</p>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Materials</h3>
            </div>
            @if (_materials is null)
            {
                <div class="loading">Loading materials...</div>
            }
            else if (!_materialsAllowed)
            {
                <div class="empty-state"><div class="empty-icon"><UiIcon Name="lock" /></div>Enroll in this course to see its materials.</div>
            }
            else if (!_materials.Any())
            {
                <div class="empty-state"><div class="empty-icon"><UiIcon Name="file-text" /></div>No materials uploaded yet.</div>
            }
            else
            {
                <div class="recommendation-list">
                    @foreach (var m in _materials)
                    {
                        <div class="recommendation-item" @onclick="() => _openMaterialId = _openMaterialId == m.Id ? null : m.Id">
                            <div class="rec-info">
                                <span class="rec-code">@m.Type</span>
                                <span class="rec-title">@m.Title</span>
                                <span class="rec-track">
                                    @m.Description
                                    @if (m.DeadlineUtc is DateTime due)
                                    {
                                        <text> &middot; Due @due.ToLocalTime().ToString("MMM d, yyyy")</text>
                                    }
                                </span>
                            </div>
                            <button type="button" class="rec-btn">@(_openMaterialId == m.Id ? "Close" : "Open")</button>
                        </div>
                        @if (_openMaterialId == m.Id && !string.IsNullOrWhiteSpace(m.Content))
                        {
                            <div class="card-body"><div class="material-content" dir="auto">@m.Content</div></div>
                        }
                    }
                </div>
            }
        </div>
    }
}
else
{
    <!-- Course List View -->
    <div class="page-header">
        <h1>My Courses</h1>
        <p>Browse available courses and enroll.</p>
    </div>
    <nav class="admin-tabs" aria-label="My Courses">
        <NavLink href="/university" Match="NavLinkMatch.All" class="admin-tab">My courses &amp; materials</NavLink>
        <span class="admin-tab selected" aria-current="page">Browse &amp; enroll</span>
    </nav>

    <div class="search-section">
        <div class="search-box-large">
            <span class="search-icon"><UiIcon Name="search" /></span>
            <input type="text" placeholder="Search courses..." @bind="_searchQuery" @bind:event="oninput" @onkeyup="HandleSearch" />
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Available Courses</h3>
        </div>
        @if (_courses is null)
        {
            <div class="loading">Loading courses...</div>
        }
        else if (!_courses.Any())
        {
            <div class="empty-state"><div class="empty-icon"><UiIcon Name="book-open" /></div>No courses found.</div>
        }
        else
        {
            <div class="course-grid">
                @foreach (var course in _filteredCourses)
                {
                    <div class="course-card" @onclick="() => NavigateToCourse(course.Id)">
                        <div class="course-card-header">
                            <span class="course-code">@course.Code</span>
                            <span class="course-track">@course.Track</span>
                        </div>
                        <h4>@course.Title</h4>
                        <p>@course.Description</p>
                        @if (!string.IsNullOrWhiteSpace(course.Instructors))
                        {
                            <p class="course-meta">Instructor: @course.Instructors</p>
                        }
                        <div class="course-footer">
                            <span>@course.Credits credits</span>
                            <span class="view-link">View <UiIcon Name="arrow-right" /></span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

</RoleGate>
@code {
    [Parameter] public int? Id { get; set; }

    private List<CourseDto>? _courses;
    private CourseDto? _course;
    private List<MaterialDto>? _materials;
    private bool _materialsAllowed;
    private int? _openMaterialId;
    private string _searchQuery = "";

    private IEnumerable<CourseDto> _filteredCourses =>
        string.IsNullOrWhiteSpace(_searchQuery)
            ? _courses ?? Enumerable.Empty<CourseDto>()
            : _courses!.Where(c =>
                c.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                c.Code.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                c.Description.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));

    // The list and detail routes share this component, so Blazor reuses it when moving between them.
    protected override async Task OnParametersSetAsync()
    {
        if (Id.HasValue)
        {
            if (_course?.Id == Id) return;
            _course = null;
            _materials = null;
            _openMaterialId = null;
            _course = await Http.GetFromJsonAsync<CourseDto>($"/api/courses/{Id}");
            // Students only see materials of courses they take or that belong to their year.
            var response = await Http.GetAsync($"/api/university/me/materials?courseId={Id}&pageSize=50");
            _materialsAllowed = response.IsSuccessStatusCode;
            _materials = _materialsAllowed
                ? (await response.Content.ReadFromJsonAsync<PagedResultDto<MaterialDto>>())?.Items.ToList() ?? new()
                : new();
        }
        else if (_courses is null)
        {
            _courses = await Http.GetFromJsonAsync<List<CourseDto>>("/api/courses");
        }
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        // Client-side filtering already handled by _filteredCourses
    }

    private void NavigateToCourse(int id) => Nav.NavigateTo($"/courses/{id}");

    private async Task Enroll()
    {
        if (_course is null) return;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/enrollments", new { courseId = _course.Id });
            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/enrollments");
            }
        }
        catch
        {
            // Handle error
        }
    }
}
