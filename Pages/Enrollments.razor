@page "/enrollments"
@attribute [Authorize(Roles = "Student")]
@*
[Authorize] removed on purpose (see Dashboard.razor): the server
challenges every F5 to /login because the browser never sends the
localStorage JWT as a bearer header. /api stays [Authorize]-guarded
and MainLayout bounces anonymous users to /login after auth resolves.
*@
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<PageTitle>My Enrollments - UniSphere 360+</PageTitle>

<div class="page-header">
    <h1>My Enrollments</h1>
    <p>View and manage your course enrollments.</p>
</div>

<div class="card">
    <div class="card-header">
        <h3>Current Enrollments</h3>
        <NavLink href="/courses" class="btn btn-primary btn-sm">Browse Courses</NavLink>
    </div>

    @if (_enrollments is null)
    {
        <div class="loading">Loading enrollments...</div>
    }
    else if (!_enrollments.Any())
    {
        <div class="empty-state"><div class="empty-icon"><UiIcon Name="book-open" /></div>You are not enrolled in any courses. Browse available courses to get started.</div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th>Code</th>
                        <th>Semester</th>
                        <th>Grade</th>
                        <th>Attendance</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrollment in _enrollments)
                    {
                        <tr>
                            <td>@enrollment.CourseTitle</td>
                            <td>@enrollment.CourseCode</td>
                            <td>@enrollment.Semester</td>
                            <td>@enrollment.GradeLetter</td>
                            <td>@enrollment.AttendancePercent%</td>
                            <td><span class="status-badge @enrollment.Status.ToLower().Replace(" ", "-")">@enrollment.Status</span></td>
                            <td>
                                <button class="btn btn-sm btn-danger" @onclick="() => DropEnrollment(enrollment.Id)">Drop</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<EnrollmentDto>? _enrollments;

    protected override async Task OnInitializedAsync()
    {
        _enrollments = await Http.GetFromJsonAsync<List<EnrollmentDto>>("/api/enrollments");
    }

    private async Task DropEnrollment(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to drop this course?")) return;

        await Http.DeleteAsync($"/api/enrollments/{id}");
        _enrollments = await Http.GetFromJsonAsync<List<EnrollmentDto>>("/api/enrollments");
    }
}

public record EnrollmentDto(int Id, int CourseId, string CourseCode, string CourseTitle, string Semester, string GradeLetter, double GradePoints, int AttendancePercent, string Status);
