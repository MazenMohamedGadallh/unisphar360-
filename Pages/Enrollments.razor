@page "/enrollments"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<PageTitle>My Enrollments - UniSphere 360+</PageTitle>
<RoleGate Roles="Student">

<div class="page-header">
    <h1>My Enrollments</h1>
    <p>View and manage your course enrollments.</p>
</div>

<div class="card record-card">
    <div class="card-header">
        <h3>Add a course with my grade</h3>
        <span class="muted">Enter courses you already took or are taking, with your own grade. Your GPA is calculated from these.</span>
    </div>
    @if (!string.IsNullOrEmpty(_addMessage))
    {
        <div class="alert @(_addOk ? "alert-info" : "alert-error")" role="status">@_addMessage</div>
    }
    <div class="record-form">
        <div class="form-group">
            <label for="add-course">Course</label>
            <select id="add-course" @bind="_addCourseId">
                <option value="0">Select a course…</option>
                @foreach (var c in AvailableCourses)
                {
                    <option value="@c.Id">@c.Code — @c.Title</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="add-sem">Semester</label>
            <input id="add-sem" @bind="_addSemester" maxlength="40" placeholder="e.g. Fall 2025" />
        </div>
        <div class="form-group">
            <label for="add-grade">Grade</label>
            <select id="add-grade" @bind="_addGrade">
                <option value="">No grade yet</option>
                @foreach (var g in Grades) { <option value="@g">@g</option> }
            </select>
        </div>
        <div class="form-group">
            <label for="add-att">Attendance %</label>
            <input id="add-att" type="number" min="0" max="100" @bind="_addAttendance" />
        </div>
        <button type="button" class="btn btn-primary" @onclick="AddCourseAsync" disabled="@(_addBusy || _addCourseId == 0)">
            <UiIcon Name="plus" /> Add course
        </button>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3>Current Enrollments</h3>
        <NavLink href="/university/browse" class="btn btn-primary btn-sm">Browse Courses</NavLink>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-error">@_error <button class="btn btn-small" @onclick="LoadAsync">Retry</button></div>
    }
    @if (!string.IsNullOrEmpty(_dropMessage))
    {
        <div class="alert alert-error" role="status">@_dropMessage</div>
    }

    @if (_loading)
    {
        <div class="loading">Loading enrollments...</div>
    }
    else if (_enrollments is not null && !_enrollments.Any())
    {
        <div class="empty-state"><div class="empty-icon"><UiIcon Name="book-open" /></div>You are not enrolled in any courses. Browse available courses to get started.</div>
    }
    else if (_enrollments is not null)
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th>Code</th>
                        <th>Semester</th>
                        <th>Grade</th>
                        <th>Attendance</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrollment in _enrollments)
                    {
                        @if (_editId == enrollment.Id)
                        {
                            <tr class="editing-row">
                                <td>@enrollment.CourseTitle</td>
                                <td>@enrollment.CourseCode</td>
                                <td><input class="cell-input" @bind="_editSemester" maxlength="40" aria-label="Semester" /></td>
                                <td>
                                    <select class="cell-input" @bind="_editGrade" aria-label="Grade">
                                        <option value="">—</option>
                                        @foreach (var g in Grades) { <option value="@g">@g</option> }
                                    </select>
                                </td>
                                <td><input class="cell-input" type="number" min="0" max="100" @bind="_editAttendance" aria-label="Attendance" /></td>
                                <td></td>
                                <td class="row-actions">
                                    <button class="btn btn-sm btn-primary" @onclick="() => SaveEditAsync(enrollment.Id)" disabled="@(_busyId == enrollment.Id)">Save</button>
                                    <button class="btn btn-sm btn-secondary" @onclick="() => _editId = 0">Cancel</button>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>@enrollment.CourseTitle</td>
                                <td>@enrollment.CourseCode</td>
                                <td>@enrollment.Semester</td>
                                <td>@(string.IsNullOrEmpty(enrollment.GradeLetter) ? "—" : enrollment.GradeLetter)</td>
                                <td>@enrollment.AttendancePercent%</td>
                                <td><span class="status-badge @enrollment.Status.ToLower().Replace(" ", "-")">@enrollment.Status</span></td>
                                <td class="row-actions">
                                    <button class="btn btn-sm btn-secondary" @onclick="() => StartEdit(enrollment)" title="Edit my grade, semester and attendance">
                                        <UiIcon Name="pencil" /> Edit
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => DropEnrollment(enrollment.Id)"
                                            disabled="@(_busyId == enrollment.Id || !string.IsNullOrEmpty(enrollment.GradeLetter))"
                                            title="@(string.IsNullOrEmpty(enrollment.GradeLetter) ? "Drop this course" : "Clear the grade (Edit) before dropping")">
                                        Drop
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

</RoleGate>
@code {
    private List<EnrollmentDto>? _enrollments;
    private bool _loading = true;
    private string? _error;
    private string? _dropMessage;
    private int _busyId;

    private static readonly string[] Grades = { "A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D+", "D", "F" };
    private List<CourseDto>? _allCourses;
    private int _addCourseId;
    private string _addSemester = "Current";
    private string _addGrade = "";
    private int _addAttendance = 100;
    private bool _addBusy, _addOk;
    private string? _addMessage;
    private int _editId;
    private string _editSemester = "", _editGrade = "";
    private int _editAttendance;

    private IEnumerable<CourseDto> AvailableCourses =>
        (_allCourses ?? new()).Where(c => _enrollments is null || !_enrollments.Any(e => e.CourseId == c.Id));

    private void StartEdit(EnrollmentDto e)
    {
        _editId = e.Id; _editSemester = e.Semester; _editGrade = e.GradeLetter; _editAttendance = e.AttendancePercent;
    }

    private async Task<string> ReadErrorAsync(HttpResponseMessage r)
    {
        var body = "";
        try { body = (await r.Content.ReadAsStringAsync()).Trim('"'); } catch { /* ignore */ }
        return body.Length is > 0 and < 200 ? body : $"Request failed ({(int)r.StatusCode}).";
    }

    private async Task SaveEditAsync(int id)
    {
        _busyId = id; _dropMessage = null;
        try
        {
            var r = await Http.PutAsJsonAsync($"/api/enrollments/{id}/my-record",
                new { semester = _editSemester, gradeLetter = _editGrade, attendancePercent = _editAttendance });
            if (!r.IsSuccessStatusCode) { _dropMessage = await ReadErrorAsync(r); _busyId = 0; return; }
            _editId = 0;
        }
        catch (Exception ex) { _dropMessage = $"Save failed ({(ex.InnerException ?? ex).Message})."; }
        _busyId = 0;
        await LoadAsync();
    }

    private async Task AddCourseAsync()
    {
        _addBusy = true; _addMessage = null;
        try
        {
            var r = await Http.PostAsJsonAsync("/api/enrollments",
                new { courseId = _addCourseId, semester = _addSemester, gradeLetter = _addGrade, attendancePercent = _addAttendance });
            if (r.IsSuccessStatusCode)
            {
                _addOk = true; _addMessage = "Course added. Your GPA and dashboard are updated.";
                _addCourseId = 0; _addGrade = "";
                await LoadAsync();
            }
            else { _addOk = false; _addMessage = await ReadErrorAsync(r); }
        }
        catch (Exception ex) { _addOk = false; _addMessage = $"Could not add the course ({(ex.InnerException ?? ex).Message})."; }
        _addBusy = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        try { _allCourses = await Http.GetFromJsonAsync<List<CourseDto>>("/api/courses"); } catch { _allCourses = new(); }
    }

    private async Task LoadAsync()
    {
        _error = null;
        _loading = true;
        StateHasChanged();
        try
        {
            _enrollments = await Http.GetFromJsonAsync<List<EnrollmentDto>>("/api/enrollments");
        }
        catch (Exception ex)
        {
            _error = $"Could not load enrollments ({(ex.InnerException ?? ex).Message}).";
        }
        _loading = false;
        StateHasChanged();
    }

    private async Task DropEnrollment(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to drop this course?")) return;
        _busyId = id;
        _dropMessage = null;
        StateHasChanged();
        HttpResponseMessage response;
        try
        {
            response = await Http.DeleteAsync($"/api/enrollments/{id}");
        }
        catch (Exception ex)
        {
            _busyId = 0;
            _dropMessage = $"Drop failed ({(ex.InnerException ?? ex).Message}).";
            StateHasChanged();
            return;
        }
        _busyId = 0;
        if (!response.IsSuccessStatusCode)
        {
            var body = "";
            try { body = await response.Content.ReadAsStringAsync(); } catch { /* ignore */ }
            _dropMessage = response.StatusCode == System.Net.HttpStatusCode.BadRequest
                ? "This course already has a grade, so it cannot be dropped."
                : $"Drop failed ({(body.Length > 160 ? body[..160] : body)})";
            StateHasChanged();
            return;
        }
        await LoadAsync();
    }
}
