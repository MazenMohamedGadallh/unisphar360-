@page "/notifications"
@using System.Net
@*
[Authorize] removed on purpose (see Dashboard.razor): the server
challenges every F5 to /login because the browser never sends the
localStorage JWT as a bearer header. /api stays [Authorize]-guarded
and MainLayout bounces anonymous users to /login after auth resolves.
*@
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Notifications - UniSphere 360+</PageTitle>

<div class="page-header">
    <h1>Notifications</h1>
    <p>Stay updated with the latest announcements and reminders.</p>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-error">
        @_error
        <button class="btn-sm btn btn-secondary" @onclick="LoadAsync">Retry</button>
    </div>
}

<div class="card">
    <div class="card-header">
        <h3>All Notifications</h3>
        <button class="btn btn-sm btn-secondary" @onclick="MarkAllRead">Mark All as Read</button>
    </div>

    @if (_notifications is null)
    {
        <div class="loading">Loading notifications...</div>
    }
    else if (!_notifications.Any())
    {
        <div class="empty-state">You have no notifications.</div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var notification in _notifications)
            {
                <div class="notification-item @(notification.IsRead ? "" : "unread")" @onclick="() => MarkRead(notification.Id)">
                    <div class="notification-indicator">
                        @if (!notification.IsRead)
                        {
                            <span class="unread-dot"></span>
                        }
                    </div>
                    <div class="notification-content">
                        <h4>@notification.Title</h4>
                        <p>@notification.Body</p>
                        <span class="notification-time">@notification.CreatedAtUtc.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    @if (!notification.IsRead)
                    {
                        <button class="btn btn-sm btn-link" @onclick:stopPropagation="true" @onclick="() => MarkRead(notification.Id)">Mark Read</button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private List<NotificationDto>? _notifications;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _notifications = null;
        StateHasChanged();
        try
        {
            _notifications = await Http.GetFromJsonAsync<List<NotificationDto>>("/api/notifications");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            Nav.NavigateTo("/login?expired=1", replace: true);
        }
        catch (Exception ex)
        {
            // Network/timeout/parse issues must surface as a retryable
            // message, not an unhandled circuit failure (CircuitNotActive).
            _error = $"Could not load notifications ({(ex.InnerException ?? ex).Message}).";
        }
        StateHasChanged();
    }

    private async Task MarkRead(int id)
    {
        try
        {
            await Http.PostAsync($"/api/notifications/{id}/read", null);
        }
        catch { /* keep UI feedback; badge refresh happens on next load */ }
        if (_notifications is not null)
        {
            var index = _notifications.FindIndex(n => n.Id == id);
            if (index >= 0)
            {
                var updated = _notifications[index] with { IsRead = true };
                _notifications[index] = updated;
            }
        }
    }

    private async Task MarkAllRead()
    {
        try
        {
            await Http.PostAsync("/api/notifications/read-all", null);
        }
        catch { /* same as above */ }
        if (_notifications is not null)
        {
            for (int i = 0; i < _notifications.Count; i++)
            {
                _notifications[i] = _notifications[i] with { IsRead = true };
            }
        }
    }
}

public record NotificationDto(int Id, string Title, string Body, DateTime CreatedAtUtc, bool IsRead);
