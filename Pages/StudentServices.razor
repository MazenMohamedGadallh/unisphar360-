@page "/student-services"
@* Student Events was a subset of this page; its URL now lands here. *@
@page "/events"
@*
[Authorize] removed on purpose (see Dashboard.razor): the server
challenges every F5 to /login because the browser never sends the
localStorage JWT as a bearer header. /api stays [Authorize]-guarded
and MainLayout bounces anonymous users to /login after auth resolves.
*@
@inject HttpClient Http

<PageTitle>Campus - UniSphere 360+</PageTitle>
<RoleGate Roles="Student">

<div class="page-header">
    <h1>Campus</h1>
    <p>Announcements, events and answers to common questions.</p>
</div>

<!-- Announcements -->
<div class="card" style="margin-bottom: 24px;">
    <div class="card-header">
        <h3>Announcements</h3>
    </div>
    @if (_announcements is null)
    {
        <div class="loading">Loading announcements...</div>
    }
    else if (!_announcements.Any())
    {
        <div class="empty-state"><div class="empty-icon"><UiIcon Name="megaphone" /></div>No announcements at this time.</div>
    }
    else
    {
        <div class="announcement-list">
            @foreach (var ann in _announcements)
            {
                <div class="announcement-item">
                    <div class="announcement-header">
                        <h4>@ann.Title</h4>
                        <span class="announcement-category">@ann.Category@(string.IsNullOrWhiteSpace(ann.CourseName) ? "" : $" - {ann.CourseName}")</span>
                    </div>
                    <p>@ann.Body</p>
                    <span class="announcement-date">@ann.CreatedAtUtc.ToString("MMM dd, yyyy")</span>
                </div>
            }
        </div>
    }
</div>

<!-- Events -->
<div class="card" style="margin-bottom: 24px;">
    <div class="card-header">
        <h3>Upcoming Events</h3>
    </div>
    @if (_events is null)
    {
        <div class="loading">Loading events...</div>
    }
    else if (!_events.Any())
    {
        <div class="empty-state"><div class="empty-icon"><UiIcon Name="calendar-days" /></div>No upcoming events.</div>
    }
    else
    {
        <div class="event-list">
            @foreach (var evt in _events)
            {
                <div class="event-item">
                    <div class="event-date">
                        <span class="event-day">@evt.StartsAtUtc.Day</span>
                        <span class="event-month">@evt.StartsAtUtc.ToString("MMM")</span>
                    </div>
                    <div class="event-info">
                        <h4>@evt.Title</h4>
                        <p><UiIcon Name="map-pin" /> @evt.Location</p>
                        <p><UiIcon Name="clock-3" /> @evt.StartsAtUtc.ToString("hh:mm tt")</p>
                        @if (!string.IsNullOrWhiteSpace(evt.Description))
                        {
                            <p>@evt.Description</p>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- FAQs -->
<div class="card">
    <div class="card-header">
        <h3>Frequently Asked Questions</h3>
    </div>
    <div class="faq-list">
        <div class="faq-item">
            <h4>How do I enroll in a course?</h4>
            <p>Go to the Courses page, find a course you're interested in, and click the Enroll button. You can also ask your academic advisor for recommendations.</p>
        </div>
        <div class="faq-item">
            <h4>How is my GPA calculated?</h4>
            <p>GPA is calculated based on your grade points divided by total credits. Each grade letter corresponds to a point value (A=4.0, B+=3.3, B=3.0, etc.).</p>
        </div>
        <div class="faq-item">
            <h4>How do I change my study plan?</h4>
            <p>Navigate to the Study Planner page. You can add, edit, or delete study items. Changes are saved automatically.</p>
        </div>
        <div class="faq-item">
            <h4>Who do I contact for academic support?</h4>
            <p>Reach out to your academic advisor or visit the Student Services office during working hours.</p>
        </div>
    </div>
</div>


</RoleGate>
@code {
    private List<AnnouncementDto>? _announcements;
    private List<EventDto>? _events;

    protected override async Task OnInitializedAsync()
    {
        _announcements = await Http.GetFromJsonAsync<List<AnnouncementDto>>("/api/announcements");
        _events = await Http.GetFromJsonAsync<List<EventDto>>("/api/events?upcoming=true");
    }
}
