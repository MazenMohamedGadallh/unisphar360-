@page "/login"
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject UniSphere.Api.Services.BlazorAuthService AuthService
@inject NavigationManager Nav

<PageTitle>Login - UniSphere 360+</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h1>Welcome Back</h1>
            <p>Sign in to your UniSphere 360+ account</p>
        </div>

        @if (Expired == "1")
        {
            <div class="alert alert-error">Session expired. Please sign in again.</div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-error">@_error</div>
        }

        <form @onsubmit="HandleLogin">
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" @bind="_email" placeholder="Enter your email" required />
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" @bind="_password" placeholder="Enter your password" required />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@_loading">
                @(_loading ? "Signing in..." : "Sign In")
            </button>
        </form>

        <div class="auth-switch">
            <span>Don't have an account? <NavLink href="/register">Register</NavLink></span>
        </div>

        <div class="login-footer">
            <p>Demo accounts (click to fill, then Sign In):</p>
            <ul class="demo-accounts">
                @foreach (var account in DemoAccounts)
                {
                    <li>
                        <button type="button" class="demo-btn" @onclick="(e) => FillDemo(account)">
                            <strong>@account.Role</strong>
                            <span>@account.Email</span>
                            <span>@account.Password</span>
                        </button>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string? _error;
    private bool _loading;

    private sealed record DemoUser(string Role, string Email, string Password);

    // Matches the README "Demo Accounts" table, plus this project's extra
    // Helwan demo student (Password123! seed in DbSeeder).
    private static readonly DemoUser[] DemoAccounts =
    [
        new("Student", "mazenmohamed@unisphere.edu", "Password123!"),
        new("Student (Helwan)", "helwan.student@unisphere.edu", "Password123!"),
        new("Graduate", "graduate@unisphere.edu", "Graduate123!"),
        new("Doctor", "doctor@unisphere.edu", "Doctor123!"),
        new("Admin", "admin@unisphere.edu", "Admin123!")
    ];

    private void FillDemo(DemoUser account)
    {
        _email = account.Email;
        _password = account.Password;
        _error = null;
    }

    [SupplyParameterFromQuery(Name = "expired")]
    public string? Expired { get; set; }

    // Deep links (or an F5 on a protected nested route) arrive here with a
    // returnUrl courtesy of the auth challenge redirect in Program.cs.
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    /// <summary>Only navigate to local app paths. Rejects protocol URLs,
    /// protocol-relative hosts (//evil.com), backslashes and control
    /// characters so returnUrl can never act as an open redirect.</summary>
    private static bool IsSafeReturnUrl(string? url) =>
        !string.IsNullOrEmpty(url)
        && url.StartsWith('/')
        && !url.StartsWith("//")
        && !url.StartsWith("/\\")
        && !url.Contains('\\')
        && url.All(c => !char.IsControl(c))
        && url != "/login";

    private string LandingPath =>
        IsSafeReturnUrl(ReturnUrl) ? ReturnUrl!
        // Role-aware landing (this project's RoleRoutes): doctors go to their
        // dashboard, admins to the admin panel, graduates to /graduate.
        : (Fetch?.Role is null ? "/dashboard" : UniSphere.Api.Services.RoleRoutes.HomeFor(Fetch.Role));

    private AuthUserDto? Fetch { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Already signed in (typed URL / Back / link): don't show the form.
        var user = await AuthService.GetUserAsync();
        if (user is not null)
        {
            Fetch = user;
            Nav.NavigateTo(LandingPath, replace: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Full reload (F5): the scoped auth service starts empty, so the
        // persisted token can only be read once JS interop is available
        // (OnAfterRenderAsync — never during prerender). Restore it here:
        // a signed-in user should land on their destination, not the form.
        if (firstRender && await AuthService.RestoreSessionAsync())
            Nav.NavigateTo(LandingPath, replace: true);
    }

    private async Task HandleLogin(EventArgs e)
    {
        _loading = true;
        _error = null;

        try
        {
            var token = await AuthService.LoginAsync(_email, _password);
            if (token is not null)
            {
                // Client-side navigation keeps the same circuit, so the
                // in-memory JWT stored by BlazorAuthService survives.
                // forceLoad: true would reload the page, drop the token,
                // and bounce straight back to /login.
                var user = await AuthService.GetUserAsync();
                Fetch = user;
                var target = IsSafeReturnUrl(ReturnUrl)
                    ? ReturnUrl!.Trim()
                    : user is not null && string.Equals(user.Role, "Admin", StringComparison.OrdinalIgnoreCase)
                        ? "/analytics"
                        : "/dashboard";
                Nav.NavigateTo(target);
            }
            else
            {
                _error = "Invalid email or password.";
            }
        }
        catch
        {
            _error = "Login failed. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
